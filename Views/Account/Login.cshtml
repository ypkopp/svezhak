@{
    ViewData["Title"] = "Вход";
}

<div class="sv-login-wrap">
    <div class="sv-card sv-login-card">
        <img src="~/img/brand/logo-1a-sm.png" asp-append-version="true" alt="СВЕЖАК" class="sv-login-logo" />
        <div class="sv-login-title">СВЕЖАК</div>

        <form asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <input type="text" id="code" name="code" class="sv-input" placeholder="Код доступа" required autocomplete="off" autofocus />
            @if (ViewBag.Error != null)
            {
                <div class="sv-login-error">@ViewBag.Error</div>
            }
            <button type="submit" class="btn-sv w-100 mt-3">Войти</button>
        </form>
    </div>
</div>
