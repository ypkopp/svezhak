@{
    ViewData["Title"] = "Организация";
    var restaurants = (IEnumerable<dynamic>)ViewBag.Restaurants;
}

<div class="ph rise">
    <div style="flex:1;min-width:0">
        <a class="lnk" asp-controller="Inventory" asp-action="Index" style="margin-bottom:8px;display:inline-flex;align-items:center;gap:6px">← Назад</a>
        <div class="eyebrow" style="margin-bottom:8px">Владелец · @(ViewBag.OrgName ?? "организация")</div>
        <h1 class="disp">Рестораны сети</h1>
        <p class="muted" style="margin:8px 0 0;font-size:14px">Сводка по всем точкам — горящие партии, стоп-лист, потери за неделю.</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end">
        <a class="btn sm" href="@Url.Action("Admins","Org")">Админы</a>
        <a class="btn sm" href="@Url.Action("Employees","Org")">Сотрудники</a>
        <form asp-action="CreateRestaurant" method="post" class="d-flex gap-1 m-0" style="display:flex;gap:6px">
            @Html.AntiForgeryToken()
            <input name="address" class="inp" style="width:200px;height:40px" placeholder="новая точка…" required maxlength="100" />
            <button class="btn pri ico" type="submit" title="Добавить точку">＋</button>
        </form>
    </div>
</div>

@if (ViewBag.Ok is string ok) { <div class="sv-form-success mb-3">@ok</div> }
@if (ViewBag.Error is string err) { <div class="sv-form-alert mb-3">@err</div> }

<div class="grid" style="grid-template-columns:repeat(3,1fr)">
    @foreach (var r in restaurants)
    {
        var okState = (int)r.Burning == 0 && (int)r.StopCount == 0;
        <section class="glass card rise" style="display:flex;flex-direction:column;gap:14px">
            <div style="display:flex;align-items:flex-start;gap:10px">
                <div style="flex:1">
                    <div class="eyebrow" style="font-size:9px">Точка #@r.Id</div>
                    <div class="disp" style="font-size:18px;font-weight:600;margin-top:5px">@r.Address</div>
                </div>
                <img src="~/img/brand/@(okState ? "m-avo.png" : "m-salmon.png")" style="height:58px" alt="" />
            </div>
            <div class="grid" style="grid-template-columns:repeat(3,1fr);gap:8px">
                <div style="padding:10px;border-radius:12px;background:color-mix(in oklab,var(--bg2) 50%,transparent);border:1px solid var(--stroke)"><div class="eyebrow" style="font-size:8.5px">горит &lt;24ч</div><div class="mono" style="font-size:22px;font-weight:700;margin-top:6px;color:@((int)r.Burning>0?"var(--rd)":"var(--gr)")">@r.Burning</div></div>
                <div style="padding:10px;border-radius:12px;background:color-mix(in oklab,var(--bg2) 50%,transparent);border:1px solid var(--stroke)"><div class="eyebrow" style="font-size:8.5px">в стоп-листе</div><div class="mono" style="font-size:22px;font-weight:700;margin-top:6px;color:@((int)r.StopCount>0?"var(--rd)":"var(--gr)")">@r.StopCount</div></div>
                <div style="padding:10px;border-radius:12px;background:color-mix(in oklab,var(--bg2) 50%,transparent);border:1px solid var(--stroke)"><div class="eyebrow" style="font-size:8.5px">потери · 7дн</div><div class="mono" style="font-size:14px;font-weight:700;margin-top:6px;color:@((decimal)r.LostRub>0?"var(--ye)":"var(--gr)")">@($"{r.LostRub:N0}") ₽</div></div>
            </div>
            <a class="btn" href="@Url.Action("View","Org",new{id=r.Id})" style="justify-content:center">Открыть дашборд →</a>
        </section>
    }
</div>
@if (!restaurants.Any())
{
    <div class="sv-empty"><img src="~/img/brand/m-onigiri.png" alt="" style="height:110px" /><p>Точек нет — добавьте их через форму выше.</p></div>
}

@section Scripts {<script>document.querySelectorAll('.fade-up').forEach(function(el,i){setTimeout(function(){el.classList.add('in');},50+i*60);});</script>}
