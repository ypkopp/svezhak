@{
    ViewData["Title"] = "Организация";
    var restaurants = (IEnumerable<dynamic>)ViewBag.Restaurants;
}

<div class="sv-title-row fade-up">
    <div>
        <a class="sv-backlink" asp-controller="Inventory" asp-action="Index">← Назад</a>
        <div class="sv-kicker">Владелец · @(ViewBag.OrgName ?? "организация")</div>
        <h1 class="sv-page-title">Рестораны сети</h1>
        <div class="sv-page-sub mb-0">Сводка по всем точкам — горящие партии, стоп-лист, потери за неделю.</div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a class="sv-chip" href="@Url.Action("Admins","Org")">Админы</a>
        <a class="sv-chip" href="@Url.Action("Employees","Org")">Сотрудники</a>
        <form asp-action="CreateRestaurant" method="post" class="d-flex gap-1 m-0">
            @Html.AntiForgeryToken()
            <input name="address" class="sv-input" style="max-width:200px;min-height:34px;padding:4px 10px;font-size:12px" placeholder="новая точка…" required maxlength="100" />
            <button class="btn-sv-primary btn-sm" type="submit">＋</button>
        </form>
    </div>
</div>

@if (ViewBag.Ok is string ok) { <div class="sv-form-success mb-3">@ok</div> }
@if (ViewBag.Error is string err) { <div class="sv-form-alert mb-3">@err</div> }

<div class="sv-org-grid">
    @foreach (var r in restaurants)
    {
        <div class="sv-card fade-up sv-org-card">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div class="sv-kicker">точка</div>
                    <b style="font:700 16px var(--disp)">@r.Address</b>
                </div>
                <img src="~/img/brand/st-fridge.png" style="width:34px;opacity:.7" alt="" />
            </div>
            <div class="sv-org-kpis">
                <div><span>горит &lt;24ч</span><b style="color:@((int)r.Burning>0?"var(--rd)":"var(--gr)")">@r.Burning</b></div>
                <div><span>в стоп-листе</span><b style="color:@((int)r.StopCount>0?"var(--rd)":"var(--gr)")">@r.StopCount</b></div>
                <div><span>потери · 7дн</span><b style="color:@((decimal)r.LostRub>0?"var(--ye)":"var(--mut)")">@($"{r.LostRub:N0}") ₽</b></div>
            </div>
            <a class="btn-sv-ghost btn-sm w-100 mt-3" style="justify-content:center" href="@Url.Action("View","Org",new{id=r.Id})">Открыть дашборд →</a>
        </div>
    }
</div>
@if (!restaurants.Any())
{
    <div class="sv-empty"><img src="~/img/brand/chef-4-sm.png" alt="" /><p>Точек нет — добавьте их в /Admin/Restaurants.</p></div>
}

@section Scripts {<script>document.querySelectorAll('.fade-up').forEach(function(el,i){setTimeout(function(){el.classList.add('in');},50+i*60);});</script>}
