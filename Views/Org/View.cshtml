@{
    ViewData["Title"] = "Просмотр точки";
    var r = (SmartInventory.Models.Structure.Restaurant)ViewBag.Restaurant;
    var live = (List<SmartInventory.Models.Inventory.Batch>)ViewBag.Live;
    var stop = (List<SmartInventory.Services.OrderService.StopListItem>)ViewBag.StopList;
    var now = (DateTime)ViewBag.Now;
    Func<DateTime, string> fmt = e => { var h=(e-now).TotalHours; return h<0?"просрочено": h>=48? $"{(int)h/24} дн {(int)h%24} ч": $"{h:0.#} ч"; };
}

<div class="sv-title-row fade-up">
    <div>
        <a class="sv-backlink" asp-controller="Org" asp-action="Index">← К точкам</a>
        <div class="d-flex align-items-center gap-2">
            <h1 class="sv-page-title">@r.Address</h1>
            <span class="sv-badge sv-badge-yellow">просмотр</span>
        </div>
        <div class="sv-page-sub mb-0">Read-only дашборд точки — без действий, только наблюдение.</div>
    </div>
    <img src="~/img/brand/st-check.png" style="width:40px;opacity:.7" alt="" />
</div>

<div class="sv-grid-12">
    <div class="sv-card sv-col-7 fade-up">
        <div class="sv-section-title">Живые партии (@live.Count)</div>
        <div class="sv-table-wrap">
            <table class="sv-table">
                <thead><tr><th>Продукт</th><th>Поставка</th><th>Остаток</th><th>Срок</th></tr></thead>
                <tbody>
                @foreach (var b in live.Take(12))
                {
                    var fc = b.ExpiresAt<=now.AddHours(12)?"#F56565":b.ExpiresAt<now.AddHours(24)?"#ECC94B":"#48BB78";
                    <tr>
                        <td><b>@b.Product?.Name</b></td>
                        <td class="sv-muted">@b.Delivery?.Number</td>
                        <td>@($"{b.QtyRemaining:0.##}") @b.Product?.Unit</td>
                        <td><b style="color:@fc">@fmt(b.ExpiresAt)</b></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <div class="sv-card sv-col-5 fade-up">
        <div class="sv-section-title" style="color:var(--rd)">Стоп-лист (@stop.Count)</div>
        @foreach (var s in stop)
        {
            <div class="d-flex justify-content-between align-items-center mb-2 pb-2" style="border-bottom:1px solid #ffffff0a">
                <div><b>@s.DishName</b>@if(s.IsManual){<span class="sv-badge sv-badge-yellow" style="margin-left:6px">вручную</span>}</div>
                <span class="sv-badge @(s.IsManual?"sv-badge-yellow":"sv-badge-red")">стоп</span>
            </div>
        }
        @if (!stop.Any()) { <div class="sv-muted" style="padding:14px 0">Стоп-лист пуст — всё меню доступно.</div> }
        <div class="sv-kicker mt-3 mb-1">истекает &lt;24ч</div>
        <b style="font:800 26px var(--mono);color:var(--rd)">@ViewBag.Expiring24</b>
    </div>
</div>

@section Scripts {<script>document.querySelectorAll('.fade-up').forEach(function(el,i){setTimeout(function(){el.classList.add('in');},50+i*60);});</script>}
