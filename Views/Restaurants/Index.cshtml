@model IEnumerable<SmartInventory.Models.Restaurants.RestaurantIndexViewModel>

@{
    ViewData["Title"] = "Список ресторанов";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewData["Title"]</h2>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Any())
            {
                <table class="table table-striped table-hover align-middle">
                    <thead>
                    <tr>
                        <th>ID</th>
                        <th>Адрес</th>
                        <th>Организация</th>
                        <th>ID Управляющего</th>
                        <th class="text-end">Действия</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Address</td>
                            <td>@item.OrganizationName</td>
                            <td>@item.ManagerId</td>
                            <td class="text-end">
                                <a asp-action="Dashboard" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Дашборд</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Редактировать</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mb-0">Рестораны не найдены.</p>
            }
        </div>
    </div>
</div>