@using System.Security.Claims
@using SmartInventory.Authorization
@model SmartInventory.Models.Restaurants.RestaurantIndexViewModel

@{
    ViewData["Title"] = $"Дашборд ресторана №{Model.Id}";
    var currentUserRoleString = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value!;
    var currentUserRole = Enum.Parse<AppRole>(currentUserRoleString);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewData["Title"]</h2>
        <div>
            @if (currentUserRole is AppRole.ServerAdmin or AppRole.OrganizationOwner)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Редактировать</a>
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="card-title mb-3">Информация о ресторане</h4>

            <dl class="row">
                <dt class="col-sm-3">ID:</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Адрес:</dt>
                <dd class="col-sm-9">@Model.Address</dd>

                <dt class="col-sm-3">ID Управляющего:</dt>
                <dd class="col-sm-9">@Model.ManagerId</dd>

                <dt class="col-sm-3">Организация:</dt>
                <dd class="col-sm-9">@Model.OrganizationName</dd>
            </dl>
        </div>
    </div>
</div>