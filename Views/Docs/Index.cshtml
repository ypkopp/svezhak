@{
    ViewData["Title"] = "Как это работает";

    var cards = new (string Icon, string Title, string Intro, string[] Details)[]
    {
        ("st-truck.png", "Поставки и партии",
            "Приёмка занимает полминуты: номер, продукты, количество и срок хранения в часах. Каждая строка приёмки — отдельная партия со своей датой истечения.",
            new[]{
                "Партия — это «кусок» продукта с конкретным сроком годности. Срок считается от момента приёмки: сейчас + часы хранения.",
                "Два одинаковых продукта из разных поставок — это две разные партии. Система помнит каждую и не смешивает их сроки.",
                "Пример: приехало 10 кг томата с 48 ч и ещё 10 кг с 72 ч — на складе два ряда, а не одна общая куча.",
            }),
        ("st-hourglass.png", "FEFO — сначала скоропортящееся",
            "First Expired — First Out: при списании система берёт самую раннюю партию. То, что испортится быстрее, уходит в дело первым.",
            new[]{
                "Заказ на 12 кг при партиях 10 кг (старше) и 10 кг (свежее): спишется вся старшая 10 кг и ещё 2 кг из свежей.",
                "Свежая партия «дожидается» своей очереди — меньше шансов, что она переживёт старшую и сгорит.",
                "Просроченные партии в доступность не входят вообще — их нельзя случайно продать.",
            }),
        ("st-box.png", "Заказы и списание",
            "Повар собирает заказ, система проверяет, хватит ли ингредиентов по рецепту, и списывает их по FEFO в одной транзакции.",
            new[]{
                "Не хватило хоть одного ингредиента — заказ отклоняется целиком, с причиной: «Томаты: нужно 0,60 кг, доступно 0,10 кг».",
                "При отказе остатки не трогаются — минус невозможен, списание либо прошло полностью, либо не прошло вовсе.",
                "Каждый заказ помнит, из каких партий сколько списал — это и есть история потребления.",
            }),
        ("st-stop.png", "Стоп-лист",
            "Блюдо уходит в стоп автоматически, когда по рецепту не хватает ингредиента, или вручную — по тумблеру шефа.",
            new[]{
                "Автоматический стоп снимается сам, как только приёмка снова покрывает рецепт.",
                "Ручной стоп — для особых случаев («печь сломалась»): заказ с блюдом отклоняется с пометкой «остановлено вручную: причина».",
                "На кухонном экране видно актуальный стоп-лист без входа — по ссылке с QR.",
            }),
        ("st-hot.png", "Hot Offers",
            "Партия горит — надо продать блюда, которые её съедят. Hot Offers показывает топ-5 блюд по приоритету спасения.",
            new[]{
                "Приоритет = срочность партии × доля ингредиента в блюде. Чем раньше истекает и чем больше его в рецепте — тем выше.",
                "У каждого оффера видно, какая партия горит, сколько часов осталось и сколько продукта спасёт одна порция.",
                "Список пересчитывается при каждом изменении остатков — в реальном времени.",
            }),
        ("st-hourglass.png", "Просрочка и списания",
            "Фоновый sweep каждые 60 секунд снимает с баланса истёкшие партии и пишет списание с причиной «просрочка».",
            new[]{
                "Просроченное не участвует в доступности — рецепты сразу видят дефицит честно, без «мёртвых» остатков.",
                "Ручное списание — для порчи, не дождавшейся срока: количество + причина + комментарий.",
                "Все списания копятся в журнале и складываются в аналитику потерь в рублях.",
            }),
        ("st-check.png", "Советник и ИИ",
            "Юзу каждую смену собирает сводку: что горит, что продать, что заказать. Чат ✦ отвечает вопросами по живым данным склада.",
            new[]{
                "Раз в час сервис пишет инсайт смены — он же на дашборде с меткой времени.",
                "В «Аналитике» кнопка «Анализ ИИ» читает статдамп периода и говорит, что убрать из закупок.",
                "Без AI-ключа всё работает на локальных правилах — рекомендации есть всегда, ключ лишь делает тексты умнее.",
            }),
        ("st-qr.png", "Роли и доступ",
            "Четыре уровня: менеджер видит свой ресторан, админ — смены и персонал, владелец — всю сеть, платформа — заявки с лендинга.",
            new[]{
                "MANAGER1234 — склад своей точки целиком: приёмка, заказ, стоп, советник, аналитика.",
                "ADMIN1234 — сотрудники, расписание, рестораны, продукты, импорт.",
                "OWNER1234 — все точки сети, привязка и удаление сотрудников, просмотр дашбордов. HQ000001 — заявки от сетей.",
            }),
        ("st-check.png", "Реальное время",
            "Изменения на складе видны всем без перезагрузки: SignalR шлёт события, страницы мягко обновляют виджеты.",
            new[]{
                "Заказ на одном экране — дашборд и стоп-лист двигаются на другом сразу, без F5.",
                "Для демо есть генератор нагрузки tools/EventGenerator: --scenario=rush гонит 10–15 заказов в минуту.",
                "Если событие не дошло — страховка-подписка обновляет виджеты раз в минуту.",
            }),
        ("st-box.png", "Импорт базы продуктов",
            "Новая сеть стартует не с нуля: каталог продуктов заливается файлом за пару минут.",
            new[]{
                "Скачайте шаблон CSV, заполните название/категорию/единицу/срок/цену.",
                "Предпросмотр покажет ошибки прямо в таблице — исправьте и подтвердите.",
                "Поддерживаются CSV и XLSX; дубликаты и битые строки подсвечиваются до импорта.",
            }),
    };
}

<div class="ph rise">
    <div style="flex:1;min-width:0">
        <div class="eyebrow" style="margin-bottom:8px">Гид</div>
        <h1 class="disp">Как это работает</h1>
        <p class="muted" style="margin:8px 0 0;font-size:14px">СВЕЖАК за десять карточек — от приёмки до ИИ. Для жюри и для тех, кто будет работать.</p>
    </div>
</div>

<div style="display:grid;gap:14px">
    @foreach (var (c, i) in cards.Select((x, i) => (x, i)))
    {
        <section class="glass card rise" style="padding:18px 22px">
            <div style="display:flex;gap:16px;align-items:flex-start">
                <img src="~/img/brand/@c.Icon" style="width:42px;height:42px;object-fit:contain;flex:none" alt="" />
                <div style="flex:1;min-width:0">
                    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                        <span class="eyebrow" style="color:var(--tx3);font-size:9px">@($"{i + 1:00}")</span>
                        <b class="disp" style="font-size:16px">@c.Title</b>
                        <span style="flex:1"></span>
                        <button type="button" class="btn sm ghost" data-doc-toggle>Подробнее</button>
                    </div>
                    <p class="muted" style="margin:8px 0 0;font-size:14px;line-height:1.55">@c.Intro</p>
                    <div data-doc-body hidden class="doc-body" style="margin-top:12px;padding-top:12px;border-top:1px dashed var(--stroke)">
                        @foreach (var d in c.Details)
                        {
                            <div style="display:flex;gap:9px;align-items:flex-start;font-size:13.5px;line-height:1.55">
                                <span style="color:var(--ac);flex:none">●</span>
                                <span style="color:var(--tx2)">@d</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </section>
    }
</div>

<style>
.doc-body:not([hidden]){display:flex;flex-direction:column;gap:9px}
</style>
@section Scripts {
<script>
document.querySelectorAll('[data-doc-toggle]').forEach(function (b) {
    b.addEventListener('click', function () {
        var body = b.closest('section').querySelector('[data-doc-body]');
        body.hidden = !body.hidden;
        b.textContent = body.hidden ? 'Подробнее' : 'Скрыть';
    });
});
document.querySelectorAll('.rise').forEach(function (el, i) { el.style.animationDelay = (i * 45) + 'ms'; });
</script>
}
