 @{
Layout = null; 
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - SmartInventory</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        @@font-face {
            font-family:'Widock TRIAL Bold';
            src: url('/fonts/Widock TRIAL Bold.otf') format('opentype');
            font-weight: normal;
            font-style: normal;
        }

            * {
                box-sizing: border-box;
            }

            body.login-body {
                background: #0b090f;
                height: 100vh;
                margin: 0;
                display: flex;
                align-items: center;
                justify-content: center; 
                padding-right: 0%; 
                font-family: 'Widock TRIAL Bold',system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
                overflow: hidden;
                position: relative;
            }
                
            body.login-body::before {
                    content: '';
                    position: absolute;
                    top: -15%;
                    right: -10%;
                    width: 600px;
                    height: 600px;
                    background: radial-gradient(circle, rgba(255, 255, 255, 1) 0%, transparent 70%);
                    border-radius: 50%;
                    pointer-events: none;
                    z-index: 0;
                    filter: blur(100px);
                }

                body.login-body::after {
                    content: '';
                    position: absolute;
                    bottom: -15%;
                    left: -10%;
                    width: 600px;
                    height: 600px;
                    background: radial-gradient(circle, rgba(255, 255, 255, 1) 0%, transparent 70%);
                    border-radius: 50%;
                    pointer-events: none;
                    z-index: 0;
                    filter: blur(100px);
                }

            
            .login-card {
                background: rgba(20, 16, 28, 0.85);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(45px);
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-radius: 24px;
                padding: 48px 40px;
                width: 100%;
                max-width: 380px;
                box-shadow: 0 100px 150px rgba(0, 0, 0, 0.7);
                position: relative;
                z-index: 5;
            }

            
            .login-title {
                color: #ffffff;
                font-size: 2.2rem;
                font-weight: 700;
                text-align: center;
                margin-bottom: 35px;
                letter-spacing: -0.5px;
            }

           
            .input-group-custom {
                position: relative;
                margin-bottom: 25px;
            }

                
                .input-group-custom input {
                    width: 100%;
                    background: rgba(255, 255, 255, 0.05);
                    border: 1px solid rgba(255, 255, 255, 0.12);
                    border-radius: 1275px;
                    padding: 14px 48px 14px 22px;
                    color: #ffffff;
                    font-size: 0.95rem;
                    outline: none;
                    transition: all 0.25s ease;
                }

                  

                    .input-group-custom input:focus {
                        border-color: #ffffff;
                        background: rgba(255, 255, 255, 0.08);
                        box-shadow: 0 0 18px rgba(168, 85, 247, 0.3);
                    }

            .btn-login {
                width: 100%;
                background: rgba(255, 255, 255, 0.05) !important;
                color: #ffffff !important;
                border: 2px solid rgba(255, 255, 255, 0.12) !important;
                border-radius: 50px;
                padding: 14px;
                font-weight: 700;
                font-size: 1rem;
                cursor: pointer;
                transition: all 0.5s ease;
                box-shadow: 0 4px 20px rgba(255, 255, 255, 0.2);
                margin-top: 10px;
            }

                .btn-login:hover {
                    background: rgba(255, 255, 255, 0.1) !important;
                    box-shadow: 0 4px 25px rgba(255, 255, 255, 1);
                    transform: translateY(-10px);
                }

                .btn-login:active {
                    transform: translateY(0);
                }
    </style>
</head>
<body class="login-body">

    <div class="login-card">
        <h1 class="login-title">Вход</h1>
         <form asp-action="Login" method="post">
            <div class="input-group-custom">
            </div>
        <div class="input-group-custom">
            <input type="password" name="Код доступа" placeholder="Код доступа" required autocomplete="">
        </div>

        
        <button type="submit" class="btn-login">Продолжить</button>
    </form>
</div>

</body>
</html>