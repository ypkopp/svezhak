@{
    Layout = null;
    var leadOk = TempData["LeadOk"] as string;
    var leadErr = TempData["LeadError"] as string;
}
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>СВЕЖАК — шеф и ИИ следят за складом вместе</title>
<link rel="icon" type="image/png" href="~/img/brand/svezhak-icon.png" />
<script>
  (function(){try{var r=document.documentElement;var t=localStorage.getItem('sv6-theme');if(!t){var o=localStorage.getItem('sv-theme');t=(o==='B')?'matcha':'night';}r.dataset.theme=t;}catch(e){}})();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&family=Unbounded:wght@500;600;700;800&family=Onest:wght@400;500;600;700&family=Oswald:wght@700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/css/svezhak.css" asp-append-version="true" />
<style>
/* ===== Лендинг v6 — композиция ===== */
.lp{position:relative;z-index:1}
.lp-wrap{max-width:1240px;margin:0 auto;padding:0 28px}
.mfloat{animation:mfloat 5s ease-in-out infinite}
.lnk{color:var(--ac);font-size:13.5px;font-weight:600;text-decoration:none}
.lnk:hover{text-decoration:underline}
</style>
</head>
<body>
<div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>

<div class="lp">
  <header class="lp-nav glass">
    <img src="~/img/brand/svezhak-logo-dark.svg" style="height:26px" alt="СВЕЖАК" />
    <nav style="display:flex;gap:22px;margin-left:30px">
        <a href="#Продукт" class="lp-a">Продукт</a><a href="#Интерфейс" class="lp-a">Интерфейс</a><a href="#Персонажи" class="lp-a">Персонажи</a><a href="#Заявка" class="lp-a">Заявка</a>
    </nav>
    <div style="flex:1"></div>
    <a class="btn" asp-controller="Account" asp-action="Login">Вход →</a>
  </header>

  @* HERO: человек + аниме-ассистент *@
  <section class="lp-hero">
    <img src="~/img/brand/kv-collab.png" alt="" class="lp-kv" />
    <div class="lp-hero-fade"></div>
    <div class="lp-hero-tx rise">
      <span class="chip on" style="cursor:default"><i class="dot pulse c-gr" style="width:6px;height:6px"></i>Мониторинг свежести для сетей ресторанов</span>
      <h1 class="disp">Шеф и ИИ<br />следят за складом <span class="grad-tx">вместе.</span></h1>
      <p>СВЕЖАК видит срок каждой партии, списывает по FEFO и заранее подсказывает, какое блюдо вот-вот уйдёт в стоп-лист.</p>
      <div style="display:flex;gap:12px">
        <a href="#Заявка" class="btn pri lg">Оставить заявку →</a>
        <a class="btn lg" asp-controller="Inventory" asp-action="Index">Смотреть демо</a>
      </div>
      <div style="display:flex;gap:34px;margin-top:30px">
        <div><div class="disp" style="font-size:30px;font-weight:700">−31%</div><div class="dim" style="font-size:12.5px">списаний за месяц</div></div>
        <div><div class="disp" style="font-size:30px;font-weight:700">0</div><div class="dim" style="font-size:12.5px">просрочек за неделю</div></div>
        <div><div class="disp" style="font-size:30px;font-weight:700">24/7</div><div class="dim" style="font-size:12.5px">мониторинг сроков</div></div>
      </div>
    </div>
    <div class="glass lp-float" style="right:6%;bottom:12%">
        <div style="display:flex;align-items:center;gap:10px;padding:6px 0"><span class="badge rd">стоп</span><b style="flex:1;font-size:13px">Удон с курицей</b><span class="mono c-rd" style="font-size:12px">2.4 ч</span></div>
        <div style="display:flex;align-items:center;gap:10px;padding:6px 0"><span class="badge ye">горит</span><b style="flex:1;font-size:13px">Ролл Филадельфия</b><span class="mono c-ye" style="font-size:12px">7.1 ч</span></div>
        <div style="display:flex;align-items:center;gap:10px;padding:6px 0"><span class="badge gr">ок</span><b style="flex:1;font-size:13px">Пицца Маргарита</b><span class="mono c-gr" style="font-size:12px">68 ч</span></div>
    </div>
  </section>

  @* 3 ценности с маскотами *@
  <section class="lp-sec" id="Продукт">
    <div class="eyebrow" style="color:var(--ac)">Зачем это нужно</div>
    <h2 class="disp">Три вещи, которые возвращают деньги</h2>
    <div class="grid" style="grid-template-columns:repeat(3,1fr);margin-top:34px">
      <div class="glass card lp-val" style="position:relative">
        <img class="mfloat" src="~/img/brand/m-avo.png" style="position:absolute;right:10px;top:-50px;height:110px" alt="" />
        <img src="~/img/brand/st-hot.png" style="width:46px" alt="" />
        <h3 class="disp" style="font-size:19px;margin:18px 0 8px;font-weight:600">Меньше списаний в ₽</h3>
        <p class="muted" style="margin:0;font-size:14px">Водопад потерь и риск списания по каждой партии — видно, сколько сгорит, если не продать сегодня.</p>
      </div>
      <div class="glass card lp-val" style="position:relative">
        <img class="mfloat" src="~/img/brand/m-salmon.png" style="position:absolute;right:10px;top:-50px;height:110px;animation-delay:-1.6s" alt="" />
        <img src="~/img/brand/st-stop.png" style="width:46px" alt="" />
        <h3 class="disp" style="font-size:19px;margin:18px 0 8px;font-weight:600">Живой стоп-лист</h3>
        <p class="muted" style="margin:0;font-size:14px">Блюдо уходит в стоп, когда не хватает ингредиентов. Заказ с ним отклоняется автоматически — до кассы.</p>
      </div>
      <div class="glass card lp-val" style="position:relative">
        <img class="mfloat" src="~/img/brand/m-lemon.png" style="position:absolute;right:10px;top:-50px;height:110px;animation-delay:-3.2s" alt="" />
        <img src="~/img/brand/st-check.png" style="width:46px" alt="" />
        <h3 class="disp" style="font-size:19px;margin:18px 0 8px;font-weight:600">ИИ-советник</h3>
        <p class="muted" style="margin:0;font-size:14px">Сводка смены одним абзацем и конкретные рекомендации: что продать, что заказать, что списать.</p>
      </div>
    </div>
  </section>

  @* Скриншоты продукта *@
  <section class="lp-sec" id="Интерфейс">
    <div class="eyebrow" style="color:var(--ac)">Интерфейс</div>
    <h2 class="disp">Стеклянный, крупный, живой — <span class="grad-tx">в пяти темах</span></h2>
    <p class="muted" style="max-width:560px;font-size:15px">Дашборд обновляется по SignalR без перезагрузки. Спираль свежести, пульс заказов, LED-водопад массы склада.</p>
    <div class="lp-shots">
      <figure class="shot" style="grid-column:1/3;grid-row:1/3"><div class="shot-bar"><i></i><i></i><i></i><span class="mono">svezhak.app/dashboard</span></div><img src="~/img/brand/kv-collab.png" alt="" /></figure>
      <figure class="shot" style="transform:perspective(1400px) rotateY(-4deg)"><div class="shot-bar"><i></i><i></i><i></i><span class="mono">/sklad</span></div><img src="~/img/brand/info-flow.png" alt="" /></figure>
      <figure class="shot" style="transform:perspective(1400px) rotateY(-4deg)"><div class="shot-bar"><i></i><i></i><i></i><span class="mono">/stop</span></div><img src="~/img/brand/key-visual.png" alt="" /></figure>
    </div>
    <div class="grid" style="grid-template-columns:repeat(3,1fr);margin-top:18px">
      <figure class="shot"><div class="shot-bar"><i></i><i></i><i></i><span class="mono">тема «Бумага»</span></div><img src="~/img/brand/kv-warehouse.png" alt="" /></figure>
      <figure class="shot"><div class="shot-bar"><i></i><i></i><i></i><span class="mono">тема «Матча»</span></div><img src="~/img/brand/info-flow.png" alt="" /></figure>
      <figure class="shot"><div class="shot-bar"><i></i><i></i><i></i><span class="mono">тема «Лаванда»</span></div><img src="~/img/brand/kv-collab.png" alt="" /></figure>
    </div>
  </section>

  @* Персонажи *@
  <section class="lp-sec" id="Персонажи">
    <div class="glass" style="display:grid;grid-template-columns:1fr 1.4fr;align-items:center;padding:34px 40px;overflow:hidden">
      <div>
        <div class="eyebrow" style="color:var(--ac)">Команда склада</div>
        <h2 class="disp" style="font-size:34px">Четыре помощника — четыре состояния</h2>
        <p class="muted">Ави радуется, когда всё свежее. Сёма бьёт тревогу. Лимо советует. Рисик скучает, когда склад пуст.</p>
      </div>
      <div style="display:flex;justify-content:space-around;align-items:flex-end">
        <div style="text-align:center"><img class="mfloat" src="~/img/brand/m-avo.png" style="height:150px" alt="" /><div class="eyebrow" style="margin-top:10px">Ави</div></div>
        <div style="text-align:center"><img class="mfloat" src="~/img/brand/m-salmon.png" style="height:150px;animation-delay:-1.2s" alt="" /><div class="eyebrow" style="margin-top:10px">Сёма</div></div>
        <div style="text-align:center"><img class="mfloat" src="~/img/brand/m-lemon.png" style="height:150px;animation-delay:-2.4s" alt="" /><div class="eyebrow" style="margin-top:10px">Лимо</div></div>
        <div style="text-align:center"><img class="mfloat" src="~/img/brand/m-onigiri.png" style="height:150px;animation-delay:-3.6s" alt="" /><div class="eyebrow" style="margin-top:10px">Рисик</div></div>
      </div>
    </div>
  </section>

  @* Заявка *@
  <section class="lp-sec" id="Заявка" style="text-align:center">
    <div class="eyebrow" style="color:var(--ac)">Подключение</div>
    <h2 class="disp">Оставьте заявку — подключим сеть</h2>
    <p class="muted" style="font-size:15px">Напишите название сети и контакт — обсудим договор и выдадим доступы.</p>
    <div class="glass card" style="max-width:520px;margin:30px auto 0;text-align:left;padding:28px;display:flex;flex-direction:column;gap:16px">
        @if (leadErr is not null) { <div class="sv-form-alert">@leadErr</div> }
        @if (leadOk is not null)
        {
            <div style="text-align:center;padding:20px 0">
                <img src="~/img/brand/m-avo.png" style="height:90px;margin-bottom:12px" alt="" />
                <div class="eyebrow" style="color:var(--gr)">Заявка отправлена</div>
                <h3 class="disp" style="font-size:20px;margin:10px 0 6px">Спасибо, «@leadOk»!</h3>
                <p class="muted" style="font-size:13px">Ави уже передала её менеджеру — ответим в Telegram в течение дня.</p>
                <a class="lnk" href="https://t.me/minelnickels" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;margin-top:14px">
                    <span style="width:28px;height:28px;border-radius:9px;background:#2AABEE;display:grid;place-items:center"><svg viewBox="0 0 24 24" width="15" height="15" fill="#fff"><path d="M21.9 4.6l-3.1 14.6c-.2 1-.8 1.3-1.7.8l-4.6-3.4-2.2 2.1c-.3.3-.5.5-1 .5l.4-4.6 8.4-7.6c.4-.4-.1-.5-.6-.2L7 13.4 2.4 12c-1-.3-1-1 .2-1.5l18-7c.8-.3 1.5.2 1.3 1.1z"/></svg></span>
                    или напишите нам в Telegram
                </a>
                <div><a class="btn" href="/" style="margin-top:14px">На главную</a></div>
            </div>
        }
        else
        {
            <form method="post" asp-action="Lead" asp-controller="Home" style="display:flex;flex-direction:column;gap:16px">
                @Html.AntiForgeryToken()
                <div class="field"><label>Название сети</label><input class="inp" name="networkName" placeholder="Суши-Суши" required maxlength="120" /></div>
                <div class="field"><label>Контакт / Telegram</label><input class="inp" name="contact" placeholder="&#64;username или +7…" required maxlength="120" /></div>
                <div class="field"><label>Число ресторанов</label><input class="inp" name="restaurantCount" type="number" min="1" value="1" required /></div>
                <button class="btn pri lg" type="submit" style="justify-content:center">Отправить заявку →</button>
            </form>
            <a class="lnk" href="https://t.me/minelnickels" target="_blank" rel="noopener" style="display:flex;align-items:center;gap:8px;font-size:13.5px">
                <span style="width:28px;height:28px;border-radius:9px;background:#2AABEE;display:grid;place-items:center"><svg viewBox="0 0 24 24" width="15" height="15" fill="#fff"><path d="M21.9 4.6l-3.1 14.6c-.2 1-.8 1.3-1.7.8l-4.6-3.4-2.2 2.1c-.3.3-.5.5-1 .5l.4-4.6 8.4-7.6c.4-.4-.1-.5-.6-.2L7 13.4 2.4 12c-1-.3-1-1 .2-1.5l18-7c.8-.3 1.5.2 1.3 1.1z"/></svg></span>
                или напишите нам в Telegram
            </a>
        }
    </div>
  </section>
  <footer class="foot" style="text-align:center;border:0">СВЕЖАК · склад без просрочки · @DateTime.UtcNow.Year</footer>
</div>
</body>
</html>
