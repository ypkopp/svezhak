@{
    ViewData["Title"] = "Ассортимент";
    var products = (List<SmartInventory.Models.Inventory.Product>)ViewBag.Products;
    var importRows = ViewBag.ImportRows as List<SmartInventory.Services.ProductImportService.ImportRow>;
}

<div class="ph rise">
    <div style="flex:1;min-width:0">
        <a class="lnk" asp-controller="Inventory" asp-action="Index" style="margin-bottom:8px;display:inline-flex;align-items:center;gap:6px">← Назад</a>
        <div class="eyebrow" style="margin-bottom:8px">Админ · склад</div>
        <h1 class="disp">Ассортимент</h1>
        <p class="muted" style="margin:8px 0 0;font-size:14px">База продуктов ресторана. Пополнение — файлом CSV/XLSX или через приёмку на странице Поставки.</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end">
        <a class="btn sm" href="@Url.Action("Employees","Admin")">Сотрудники</a>
        <a class="btn sm" href="@Url.Action("Schedule","Admin")">Расписание</a>
        <a class="btn sm" href="@Url.Action("Restaurants","Admin")">Рестораны</a>
    </div>
</div>

@if (ViewBag.Ok is string ok) { <div class="sv-form-success mb-3">@ok</div> }
@if (ViewBag.Error is string err) { <div class="sv-form-alert mb-3">@err</div> }

@* Полоса импорта *@
<section class="glass rise" style="display:flex;align-items:center;gap:16px;padding:14px 18px;border-style:dashed">
    <img src="~/img/brand/st-box.png" style="width:38px" alt="" />
    <div style="flex:1"><b>Загрузить ассортимент</b><div class="dim mono" style="font-size:11.5px">CSV/XLSX: название;категория;ед.изм;срок_ч;цена — разделитель ; или ,</div></div>
    <form asp-action="ImportProducts" method="post" enctype="multipart/form-data" style="display:flex;align-items:center;gap:8px">
        @Html.AntiForgeryToken()
        <label class="btn" style="cursor:pointer"><input type="file" name="file" accept=".csv,.xlsx,.xlsm,.xltx,.xltm" hidden required onchange="this.parentElement.querySelector('span').textContent=this.files[0]?this.files[0].name:'Выберите файл'" /><span>Выберите файл</span></label>
        <button type="submit" class="btn pri">Предпросмотр</button>
    </form>
</section>

@* Предпросмотр *@
@if (importRows is not null && importRows.Any())
{
    <section class="glass card rise mb-3" style="border:1px solid color-mix(in oklab,var(--ac) 35%,transparent)">
        <div class="card-h" style="flex-wrap:wrap">
            <div><div class="ttl">Предпросмотр импорта</div><span class="dim" style="font-size:11px">правь прямо в таблице, затем подтверди</span></div>
            <span class="sp"></span>
            <span class="badge @(importRows.Any(r => r.Errors.Count > 0) ? "ye" : "gr")">@importRows.Count(r => r.Errors.Count > 0) ошибок / @importRows.Count</span>
        </div>
        <form asp-action="ConfirmProducts" method="post" id="importForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="importJson" id="importJson" value="" />
            <div class="sv-table-wrap" style="max-height:420px;overflow-y:auto">
                <table class="sv-table" id="importTable">
                    <thead><tr><th>Название</th><th>Категория</th><th>Ед.</th><th>Срок, ч</th><th>Цена, ₽</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var r in importRows)
                    {
                        <tr class="@(r.Errors.Count > 0 ? "sv-import-bad" : "")">
                            <td><input class="sv-input sv-imp" data-f="Name" value="@r.Name" /></td>
                            <td><input class="sv-input sv-imp" data-f="Category" value="@r.Category" /></td>
                            <td><input class="sv-input sv-imp" data-f="Unit" value="@r.Unit" style="width:64px" /></td>
                            <td><input class="sv-input sv-imp" data-f="ShelfHours" type="number" step="1" min="0" value="@($"{r.ShelfHours:0}")" style="width:78px" /></td>
                            <td><input class="sv-input sv-imp" data-f="PurchasePrice" type="number" step="0.01" min="0" value="@($"{r.PurchasePrice:0.##}")" style="width:88px" /></td>
                            <td>
                                @if (r.Errors.Count > 0)
                                {
                                    <span class="sv-badge sv-badge-red" title="@string.Join(", ", r.Errors)">@string.Join(", ", r.Errors)</span>
                                }
                                <button type="button" class="sv-wo-btn" data-delrow><img src="~/img/brand/st-stop.png" alt="" /></button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="d-flex gap-2 mt-3 flex-wrap">
                <button type="submit" class="btn pri">Подтвердить импорт</button>
                <a class="btn ghost" asp-action="Products">Отменить</a>
            </div>
        </form>
    </section>
}

@* Текущий список *@
<section class="glass card rise">
    <div class="card-h"><span class="eyebrow">Продукты (@products.Count)</span></div>
    @if (products.Count == 0)
    {
        <div class="sv-empty"><img src="~/img/brand/m-onigiri.png" alt="" style="height:110px" /><p>Продуктов нет — загрузите файлом или через приёмку.</p></div>
    }
    else
    {
        <div class="thead" style="grid-template-columns:1.6fr 1fr 80px 100px"><span>Название</span><span>Категория</span><span>Ед.</span><span>Цена</span></div>
        <div class="rows">
        @foreach (var p in products)
        {
            <div class="row" style="grid-template-columns:1.6fr 1fr 80px 100px;min-height:44px">
                <b style="font-size:13.5px">@p.Name</b>
                <span class="badge">@p.Category</span>
                <span class="mono dim">@p.Unit</span>
                <b class="mono c-gr">@($"{p.PurchasePrice:0.##}") ₽</b>
            </div>
        }
        </div>
    }
</section>

@section Scripts {
    <script>
        var importForm = document.getElementById('importForm');
        if (importForm) {
            document.querySelectorAll('[data-delrow]').forEach(function (b) {
                b.addEventListener('click', function () { this.closest('tr').remove(); });
            });
            importForm.addEventListener('submit', function () {
                var rows = [];
                document.querySelectorAll('#importTable tbody tr').forEach(function (tr) {
                    var get = f => { var el = tr.querySelector('[data-f="' + f + '"]'); return el ? el.value.trim() : ''; };
                    rows.push({ Name: get('Name'), Category: get('Category'), Unit: get('Unit'), ShelfHours: parseFloat(get('ShelfHours')) || 0, PurchasePrice: parseFloat(get('PurchasePrice')) || 0 });
                });
                document.getElementById('importJson').value = JSON.stringify(rows);
            });
        }
        document.querySelectorAll('.fade-up').forEach(function(el,i){setTimeout(function(){el.classList.add('in');},50+i*60);});
    </script>
}
