@{
    ViewData["Title"] = "Ассортимент";
    var products = (List<SmartInventory.Models.Inventory.Product>)ViewBag.Products;
    var importRows = ViewBag.ImportRows as List<SmartInventory.Services.ProductImportService.ImportRow>;
}

<div class="sv-title-row fade-up">
    <div>
        <a class="sv-backlink" asp-controller="Inventory" asp-action="Index">← Назад</a>
        <div class="sv-kicker">Админ · склад</div>
        <h1 class="sv-page-title">Ассортимент</h1>
        <div class="sv-page-sub mb-0">База продуктов ресторана. Пополнение — файлом CSV/XLSX или через приёмку на странице Поставки.</div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a class="sv-chip" href="@Url.Action("Employees","Admin")">Сотрудники</a>
        <a class="sv-chip" href="@Url.Action("Schedule","Admin")">Расписание</a>
        <a class="sv-chip" href="@Url.Action("Restaurants","Admin")">Рестораны</a>
    </div>
</div>

@if (ViewBag.Ok is string ok) { <div class="sv-form-success mb-3">@ok</div> }
@if (ViewBag.Error is string err) { <div class="sv-form-alert mb-3">@err</div> }

@* ===== Загрузка файла ===== *@
<div class="sv-card fade-up mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div><div class="sv-section-title mb-0">Загрузить ассортимент</div><span class="sv-muted" style="font-size:11px">CSV/XLSX: название;категория;ед.изм;срок ч;цена — разделитель ; или ,</span></div>
        <form asp-action="ImportProducts" method="post" enctype="multipart/form-data" class="d-flex align-items-center gap-2">
            @Html.AntiForgeryToken()
            <input type="file" name="file" accept=".csv,.xlsx,.xlsm,.xltx,.xltm" class="sv-input" style="max-width:230px;padding:6px" required />
            <button type="submit" class="btn-sv-primary btn-sm">Предпросмотр</button>
        </form>
    </div>
</div>

@* ===== Предпросмотр ===== *@
@if (importRows is not null && importRows.Any())
{
    <div class="sv-card fade-up mb-3" style="border:1px solid color-mix(in oklab,var(--a1) 35%,transparent)">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div><div class="sv-section-title mb-0">Предпросмотр импорта</div><span class="sv-muted" style="font-size:11px">правь прямо в таблице, затем подтверди</span></div>
            <span class="sv-badge @(importRows.Any(r => r.Errors.Count > 0) ? "sv-badge-yellow" : "sv-badge-green")">@importRows.Count(r => r.Errors.Count > 0) ошибок / @importRows.Count</span>
        </div>
        <form asp-action="ConfirmProducts" method="post" id="importForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="importJson" id="importJson" value="" />
            <div class="sv-table-wrap" style="max-height:420px;overflow-y:auto">
                <table class="sv-table" id="importTable">
                    <thead><tr><th>Название</th><th>Категория</th><th>Ед.</th><th>Срок, ч</th><th>Цена, ₽</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var r in importRows)
                    {
                        <tr class="@(r.Errors.Count > 0 ? "sv-import-bad" : "")">
                            <td><input class="sv-input sv-imp" data-f="Name" value="@r.Name" /></td>
                            <td><input class="sv-input sv-imp" data-f="Category" value="@r.Category" /></td>
                            <td><input class="sv-input sv-imp" data-f="Unit" value="@r.Unit" style="width:64px" /></td>
                            <td><input class="sv-input sv-imp" data-f="ShelfHours" type="number" step="1" min="0" value="@($"{r.ShelfHours:0}")" style="width:78px" /></td>
                            <td><input class="sv-input sv-imp" data-f="PurchasePrice" type="number" step="0.01" min="0" value="@($"{r.PurchasePrice:0.##}")" style="width:88px" /></td>
                            <td>
                                @if (r.Errors.Count > 0)
                                {
                                    <span class="sv-badge sv-badge-red" title="@string.Join(", ", r.Errors)">@string.Join(", ", r.Errors)</span>
                                }
                                <button type="button" class="sv-wo-btn" data-delrow><img src="~/img/brand/st-stop.png" alt="" /></button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="d-flex gap-2 mt-3 flex-wrap">
                <button type="submit" class="btn-sv-primary">Подтвердить импорт</button>
                <a class="btn-sv-ghost" asp-action="Products">Отменить</a>
            </div>
        </form>
    </div>
}

@* ===== Текущий список ===== *@
<div class="sv-card fade-up">
    <div class="sv-section-title">Продукты (@products.Count)</div>
    @if (products.Count == 0)
    {
        <div class="sv-empty"><img src="~/img/brand/chef-4-sm.png" alt="" /><p>Продуктов нет — загрузите файлом или через приёмку.</p></div>
    }
    else
    {
        <div class="sv-table-wrap">
            <table class="sv-table">
                <thead><tr><th>Название</th><th>Категория</th><th>Ед.</th><th>Цена</th></tr></thead>
                <tbody>
                @foreach (var p in products)
                {
                    <tr>
                        <td><b>@p.Name</b></td>
                        <td><span class="sv-badge sv-badge-muted">@p.Category</span></td>
                        <td class="sv-muted">@p.Unit</td>
                        <td style="color:var(--gr)">@($"{p.PurchasePrice:0.##}") ₽</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        var importForm = document.getElementById('importForm');
        if (importForm) {
            document.querySelectorAll('[data-delrow]').forEach(function (b) {
                b.addEventListener('click', function () { this.closest('tr').remove(); });
            });
            importForm.addEventListener('submit', function () {
                var rows = [];
                document.querySelectorAll('#importTable tbody tr').forEach(function (tr) {
                    var get = f => { var el = tr.querySelector('[data-f="' + f + '"]'); return el ? el.value.trim() : ''; };
                    rows.push({ Name: get('Name'), Category: get('Category'), Unit: get('Unit'), ShelfHours: parseFloat(get('ShelfHours')) || 0, PurchasePrice: parseFloat(get('PurchasePrice')) || 0 });
                });
                document.getElementById('importJson').value = JSON.stringify(rows);
            });
        }
        document.querySelectorAll('.fade-up').forEach(function(el,i){setTimeout(function(){el.classList.add('in');},50+i*60);});
    </script>
}
