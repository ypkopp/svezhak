@using SmartInventory.Models.Structure
@{
    ViewData["Title"] = "Сотрудники";
    var codes = (List<AccessCode>)ViewBag.Codes;
    var selfId = (int?)ViewBag.SelfCodeId;
    var roles = (ValueTuple<SmartInventory.Authorization.AppRole, string>[])ViewBag.Roles;
    var isManagerView = (bool?)ViewBag.IsManagerView == true;
    if (isManagerView) roles = roles.Where(r => r.Item1 != SmartInventory.Authorization.AppRole.Admin).ToArray();
    string RoleBadge(SmartInventory.Authorization.AppRole r) => r switch
    {
        SmartInventory.Authorization.AppRole.Admin => "<span class=\"badge rd\">админ</span>",
        SmartInventory.Authorization.AppRole.RestaurantManager or SmartInventory.Authorization.AppRole.Manager => "<span class=\"badge ac\">менеджер</span>",
        SmartInventory.Authorization.AppRole.HeadChef => "<span class=\"badge ye\">шеф</span>",
        SmartInventory.Authorization.AppRole.OrganizationOwner => "<span class=\"badge ac\">владелец</span>",
        SmartInventory.Authorization.AppRole.ServerAdmin => "<span class=\"badge\">server</span>",
        _ => "<span class=\"badge gr\">повар</span>",
    };
}

<div class="ph rise">
    <div style="flex:1;min-width:0">
        <a class="lnk" asp-controller="Inventory" asp-action="Index" style="margin-bottom:8px;display:inline-flex;align-items:center;gap:6px">← Назад</a>
        <div class="eyebrow" style="margin-bottom:8px">@(isManagerView ? "Менеджер · команда" : "Админ · персонал")</div>
        <h1 class="disp">@(isManagerView ? "Команда" : "Сотрудники")</h1>
        <p class="muted" style="margin:8px 0 0;font-size:14px">@(isManagerView ? "Повара вашего ресторана. Коды и доступ." : "Access-коды входа для вашего ресторана. Код показывается один раз при создании.")</p>
    </div>
    <div class="adm-actions" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end">
        @if (!isManagerView)
        {
            <a class="btn sm" href="@Url.Action("Schedule","Admin")">Расписание</a>
            <a class="btn sm" href="@Url.Action("Restaurants","Admin")">Рестораны</a>
            <a class="btn sm" href="@Url.Action("Products","Admin")">Ассортимент</a>
            <a class="btn sm" href="@Url.Action("Tickets","Admin")">Тикеты</a>
        }
        <button class="btn pri" type="button" data-bs-toggle="modal" data-bs-target="#createEmployeeModal">＋ Новый сотрудник</button>
    </div>
</div>

@if (ViewBag.Error is string err && !string.IsNullOrEmpty(err))
{
    <div class="sv-form-alert fade-up" role="alert">@err</div>
}
@if (ViewBag.NewCode is string newCode && !string.IsNullOrEmpty(newCode))
{
    <div class="glass card fade-up" style="border-color:color-mix(in oklab,var(--gr) 45%,transparent);margin-bottom:14px">
        <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
            <img src="~/img/brand/st-check.png" style="width:40px" alt="" />
            <div style="flex:1;min-width:180px">
                <div class="eyebrow" style="color:var(--gr)">Сотрудник добавлен — код показан один раз</div>
                <div style="font:700 15px var(--disp);margin-top:4px">@ViewBag.NewCodeName</div>
            </div>
            <code class="mono" style="font-size:22px;letter-spacing:.12em;padding:12px 18px;border-radius:10px;background:#06080a;color:var(--gr);text-shadow:0 0 10px var(--gr)">@newCode</code>
            <button class="btn sm" type="button" onclick="navigator.clipboard&&navigator.clipboard.writeText('@newCode')">Копировать</button>
        </div>
        <div class="dim" style="margin-top:8px;font-size:12px">Передайте этот код сотруднику для входа. После ухода со страницы он больше не отображается.</div>
    </div>
}

<section class="glass card rise">
    <div class="card-h"><span class="eyebrow">Коды доступа</span><i class="dot pulse c-gr" style="width:8px;height:8px"></i></div>
    @if (codes.Count == 0)
    {
        <div class="sv-empty"><img src="~/img/brand/m-onigiri.png" alt="" style="height:110px" /><p>Пока нет ни одного access-кода.</p></div>
    }
    else
    {
        <div class="thead" style="grid-template-columns:1.4fr 1fr 1fr auto"><span>Сотрудник</span><span>Роль</span><span>Статус</span><span>Действие</span></div>
        <div class="rows">
        @foreach (var c in codes)
        {
            var isSelf = c.Id == selfId;
            var isOwner = c.Role == SmartInventory.Authorization.AppRole.OrganizationOwner;
            <div class="row @(c.IsActive ? "" : "sv-row-expired")" style="grid-template-columns:1.4fr 1fr 1fr auto;@(c.IsActive ? "" : "opacity:.5")">
                <div style="display:flex;align-items:center;gap:12px">
                    <span class="ava" style="width:32px;height:32px;font-size:13px;border-radius:10px">@((c.EmployeeName ?? "?")[0])</span>
                    <div><b style="font-size:13.5px">@(c.EmployeeName ?? $"Сотрудник #{c.Id}")</b><div class="mono dim" style="font-size:10.5px">@c.Code</div></div>
                </div>
                <span>@Html.Raw(RoleBadge(c.Role))</span>
                <span><span class="badge @(c.IsActive ? "gr" : "")">@(c.IsActive ? "активен" : "отключён")</span></span>
                <span style="text-align:right">
                    @if (isSelf || isOwner)
                    {
                        <span class="chip" style="height:28px">@(isSelf ? "это вы" : "владелец")</span>
                    }
                    else
                    {
                        <form asp-action="ToggleEmployee" method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.Id" />
                            @if (c.IsActive)
                            {
                                <button class="btn sm danger" type="submit" onclick="return confirm('Деактивировать @(c.EmployeeName ?? "сотрудника")? Доступ будет отключён.')">Деактивировать</button>
                            }
                            else
                            {
                                <button class="btn sm ok" type="submit">Активировать</button>
                            }
                        </form>
                    }
                </span>
            </div>
        }
        </div>
    }
</section>

@* Модалка: новый сотрудник *@
<div class="modal fade" id="createEmployeeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass" style="border-radius:24px;color:var(--tx)">
            <form asp-action="CreateEmployee" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header" style="border-color:var(--stroke)">
                    <div><div class="eyebrow">Новый сотрудник</div><h5 class="disp" style="font-size:17px">Создать access-код</h5></div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <div class="field mb-3"><label>Имя сотрудника</label><input class="inp" type="text" name="employeeName" placeholder="Например, Рин" required maxlength="100" /></div>
                    <div class="field"><label>Роль</label>
                        <select class="sv-select" name="role">
                            @foreach (var (value, label) in roles)
                            {
                                <option value="@label">@label</option>
                            }
                        </select>
                    </div>
                    <div class="sv-mnote" style="margin-top:14px">
                        <img src="~/img/brand/m-lemon.png" style="height:64px" alt="" />
                        <div class="sv-mnote-tx" style="font-size:12.5px">Код покажу один раз — сразу передай его сотруднику.</div>
                    </div>
                </div>
                <div class="modal-footer" style="border-color:var(--stroke)">
                    <button type="button" class="btn ghost" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn pri">Создать код</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>document.querySelectorAll('.fade-up').forEach(function(el,i){setTimeout(function(){el.classList.add('in');},50+i*60);});</script>
}
