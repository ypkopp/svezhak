@using SmartInventory.Models.Inventory
@using SmartInventory.Models.Structure
@{
    ViewData["Title"] = "Расписание";
    var days = (List<DateOnly>)ViewBag.Days;
    var today = (DateOnly)ViewBag.Today;
    var weekOffset = (int)ViewBag.WeekOffset;
    var shiftsByDay = (Dictionary<DateOnly, List<Shift>>)ViewBag.Shifts;
    var employees = (List<AccessCode>)ViewBag.Employees;
    var positions = (string[])ViewBag.Positions;
    string[] dayNames = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"];
    string PosColor(string p) => p switch
    {
        "шеф" => "var(--ye)",
        "менеджер" => "var(--ac)",
        _ => "var(--gr)",
    };
    var weekStart = days[0];
    var weekEnd = days[6];
    var draft = ViewBag.Draft as List<SmartInventory.Controllers.AdminController.DraftShift>;
}

<div class="ph rise">
    <div style="flex:1;min-width:0">
        <a class="lnk" asp-controller="Admin" asp-action="Employees" style="margin-bottom:8px;display:inline-flex;align-items:center;gap:6px">← Назад</a>
        <div class="eyebrow" style="margin-bottom:8px">Админ · смены</div>
        <h1 class="disp">Расписание</h1>
        <p class="muted" style="margin:8px 0 0;font-size:14px">@weekStart.ToString("dd.MM") — @weekEnd.ToString("dd.MM.yyyy") · неделя @(weekOffset == 0 ? "(текущая)" : weekOffset > 0 ? $"+{weekOffset}" : weekOffset.ToString())</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end">
        <form asp-action="AutofillSchedule" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <input type="hidden" name="weekOffset" value="@weekOffset" />
            <button class="btn" type="submit" title="2 смены/день, повара по кругу"><img src="~/img/brand/m-lemon.png" style="width:18px" alt="" />Собрать неделю</button>
        </form>
        <div class="seg">
            <a class="btn sm ghost" asp-action="Schedule" asp-route-weekOffset="@(weekOffset - 1)" style="text-decoration:none">←</a>
            <button type="button" class="on" onclick="location.href='@Url.Action("Schedule",new{weekOffset=0})'">Сегодня</button>
            <a class="btn sm ghost" asp-action="Schedule" asp-route-weekOffset="@(weekOffset + 1)" style="text-decoration:none">→</a>
        </div>
        <button class="btn pri" type="button" data-bs-toggle="modal" data-bs-target="#addShiftModal">＋ Смена</button>
    </div>
</div>

@if (ViewBag.Ok is string ok) { <div class="sv-form-success mb-3">@ok</div> }
@if (ViewBag.Error is string err && !string.IsNullOrEmpty(err))
{
    <div class="sv-form-alert fade-up" role="alert">@err</div>
}

@* Баннер черновика автосбора *@
@if (draft is not null)
{
    <section class="glass rise" style="display:flex;align-items:center;gap:14px;padding:12px 16px;border-color:color-mix(in oklab,var(--ac) 40%,transparent)">
        <img src="~/img/brand/m-lemon.png" style="height:54px" alt="" />
        <div style="flex:1"><b>Черновик автосбора готов</b><div class="dim" style="font-size:12.5px">@draft.Count смен, учтены выходные и нагрузка. Пунктирные карточки — предложение, ещё не сохранено.</div></div>
        <a class="btn ghost" asp-action="Schedule" asp-route-weekOffset="@weekOffset">Отменить</a>
        <form asp-action="SaveDraft" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <input type="hidden" name="weekOffset" value="@weekOffset" />
            <input type="hidden" name="draftJson" value="@ViewBag.DraftJson" />
            <button class="btn pri" type="submit">✓ Применить</button>
        </form>
    </section>
}

<section class="glass card rise" style="display:grid;grid-template-columns:repeat(7,1fr);gap:10px">
    @for (var i = 0; i < 7; i++)
    {
        var day = days[i];
        var isToday = day == today;
        shiftsByDay.TryGetValue(day, out var dayShifts);
        <div style="border-radius:18px;padding:10px;min-height:330px;display:flex;flex-direction:column;gap:8px;background:@(isToday ? "color-mix(in oklab,var(--ac) 9%,transparent)" : "color-mix(in oklab,var(--bg2) 40%,transparent)");border:1px solid @(isToday ? "color-mix(in oklab,var(--ac) 50%,transparent)" : "var(--stroke)")">
            <div style="display:flex;align-items:center;padding:2px 4px 6px">
                <span class="eyebrow">@dayNames[i]</span>
                <span style="flex:1"></span>
                <b class="disp" style="font-size:16px;@(isToday ? "color:var(--on-ac);background:var(--ac);border-radius:8px;padding:2px 7px" : "")">@day.Day</b>
            </div>
            @if (dayShifts is { Count: > 0 })
            {
                foreach (var s in dayShifts)
                {
                    <div class="sv-shift-card" style="--pos:@PosColor(s.Position)">
                        <div class="sv-shift-name">@(s.AccessCode?.EmployeeName ?? "—")</div>
                        <div class="sv-shift-pos">@s.Position</div>
                        <div class="sv-shift-time">@s.StartTime.ToString("HH\\:mm")–@s.EndTime.ToString("HH\\:mm")</div>
                        <form asp-action="DeleteShift" method="post" class="sv-shift-del" onsubmit="return confirm('Удалить смену @(s.AccessCode?.EmployeeName) @day.ToString("dd.MM")?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@s.Id" />
                            <input type="hidden" name="weekOffset" value="@weekOffset" />
                            <button type="submit" aria-label="Удалить">×</button>
                        </form>
                    </div>
                }
            }
            @if (draft is not null)
            {
                foreach (var d in draft)
                {
                    if (d.Day != i) continue;
                    <div class="sv-shift-card" style="--pos:var(--ac);border:1px dashed var(--ac);opacity:.8">
                        <div class="sv-shift-name">@d.Name</div>
                        <div class="sv-shift-pos">@d.Position <span class="badge ye" style="font-size:8px">черновик</span></div>
                        <div class="sv-shift-time">@d.Start–@d.End</div>
                    </div>
                }
            }
            else if (dayShifts is null || dayShifts.Count == 0)
            {
                <div class="dim" style="text-align:center;padding:10px;font-size:11px">—</div>
            }
            <button class="btn sm ghost" style="margin-top:auto;border-style:dashed;border-color:var(--stroke2)" type="button" data-bs-toggle="modal" data-bs-target="#addShiftModal">＋</button>
        </div>
    }
</section>

@* Модалка: добавить смену *@
<div class="modal fade" id="addShiftModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass" style="border-radius:24px;color:var(--tx)">
            <form asp-action="AddShift" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="weekOffset" value="@weekOffset" />
                <div class="modal-header" style="border-color:var(--stroke)">
                    <div><div class="eyebrow">Новая смена</div><h5 class="disp" style="font-size:17px">Добавить в расписание</h5></div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <div class="field mb-3"><label>Сотрудник</label>
                        <select class="sv-select" name="accessCodeId" required>
                            @foreach (var e in employees)
                            {
                                <option value="@e.Id">@(e.EmployeeName ?? $"Сотрудник #{e.Id}")</option>
                            }
                        </select>
                    </div>
                    <div class="field mb-3"><label>Дата</label><input class="inp" type="date" name="date" value="@today.ToString("yyyy-MM-dd")" required /></div>
                    <div class="row g-2 mb-3">
                        <div class="col"><label class="sv-label d-block mb-1">Начало</label><input class="inp" type="time" name="startTime" value="09:00" required /></div>
                        <div class="col"><label class="sv-label d-block mb-1">Конец</label><input class="inp" type="time" name="endTime" value="23:00" required /></div>
                    </div>
                    <div class="field"><label>Должность</label>
                        <select class="sv-select" name="position">
                            @foreach (var p in positions)
                            {
                                <option value="@p">@p</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer" style="border-color:var(--stroke)">
                    <button type="button" class="btn ghost" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn pri">Добавить</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>document.querySelectorAll('.fade-up').forEach(function(el,i){setTimeout(function(){el.classList.add('in');},50+i*60);});</script>
}
