@using SmartInventory.Models.Structure
@{
    ViewData["Title"] = "Рестораны";
    var list = (List<Restaurant>)ViewBag.Restaurants;
    var sort = (string?)ViewBag.Sort;
}

<div class="sv-title-row fade-up">
    <div>
        <a class="sv-backlink" asp-controller="Inventory" asp-action="Index">← Назад</a>
        <div class="sv-kicker">Админ · точки</div>
        <h1 class="sv-page-title">Рестораны</h1>
        <div class="sv-page-sub mb-0">Точки вашей организации. Склад и расписание ведутся по активному ресторану.</div>
    </div>
    <span class="sv-badge sv-badge-muted">просмотр · создание у владельца сети</span>
</div>

@if (ViewBag.Ok is string ok) { <div class="sv-form-success mb-3">@ok</div> }
@if (ViewBag.Error is string err) { <div class="sv-form-alert mb-3">@err</div> }

<div class="sv-card fade-up">
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <div class="sv-section-title mb-0">Точки организации</div>
        <div class="d-flex gap-1">
            <a class="sv-chip @(sort != "address" ? "active" : "")" href="@Url.Action("Restaurants")">по дате</a>
            <a class="sv-chip @(sort == "address" ? "active" : "")" href="@Url.Action("Restaurants", new { sort = "address" })">по адресу</a>
        </div>
    </div>
    @if (list.Count == 0)
    {
        <div class="sv-empty"><img src="~/img/brand/chef-4-sm.png" alt="" /><p>Ресторанов пока нет.</p></div>
    }
    else
    {
        <div class="sv-table-wrap">
            <table class="sv-table">
                <thead><tr><th>ID</th><th>Адрес</th><th>Терминал кухни</th><th></th></tr></thead>
                <tbody>
                @foreach (var r in list)
                {
                    <tr>
                        <td class="sv-muted">#@r.Id</td>
                        <td><b>@r.Address</b></td>
                        <td>
                            <a class="sv-ai-note" href="/Kitchen/@r.KitchenToken" target="_blank" title="Открыть терминал">/Kitchen/@r.KitchenToken.ToString()[..8]…</a>
                            <form asp-action="RegenKitchen" method="post" style="display:inline;margin-left:8px">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                <button class="btn-sv-ghost" type="submit" style="min-height:24px;padding:0 8px;font-size:10px" title="Новая ссылка">↻</button>
                            </form>
                        </td>
                        <td><span class="sv-badge sv-badge-green">активна</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@* Форма добавления перенесена владельцу в /Org — здесь только просмотр *@

@section Scripts {
    <script>document.querySelectorAll('.fade-up').forEach(function(el,i){setTimeout(function(){el.classList.add('in');},50+i*60);});</script>
}
