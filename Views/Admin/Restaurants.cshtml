@using SmartInventory.Models.Structure
@{
    ViewData["Title"] = "Рестораны";
    var list = (List<Restaurant>)ViewBag.Restaurants;
    var sort = (string?)ViewBag.Sort;
}

<div class="ph rise">
    <div style="flex:1;min-width:0">
        <a class="lnk" asp-controller="Inventory" asp-action="Index" style="margin-bottom:8px;display:inline-flex;align-items:center;gap:6px">← Назад</a>
        <div class="eyebrow" style="margin-bottom:8px">Админ · точки</div>
        <h1 class="disp">Рестораны</h1>
        <p class="muted" style="margin:8px 0 0;font-size:14px">Точки вашей организации. Склад и расписание ведутся по активному ресторану.</p>
    </div>
    <span class="badge">просмотр · создание у владельца сети</span>
</div>

@if (ViewBag.Ok is string ok) { <div class="sv-form-success mb-3">@ok</div> }
@if (ViewBag.Error is string err) { <div class="sv-form-alert mb-3">@err</div> }

<section class="glass card rise">
    <div class="card-h" style="flex-wrap:wrap">
        <span class="eyebrow">Точки организации</span><span class="sp"></span>
        <div class="seg">
            <a class="btn sm ghost @(sort != "address" ? "on" : "")" href="@Url.Action("Restaurants")" style="text-decoration:none">по дате</a>
            <a class="btn sm ghost @(sort == "address" ? "on" : "")" href="@Url.Action("Restaurants", new { sort = "address" })" style="text-decoration:none">по адресу</a>
        </div>
    </div>
    @if (list.Count == 0)
    {
        <div class="sv-empty"><img src="~/img/brand/m-onigiri.png" alt="" style="height:110px" /><p>Ресторанов пока нет.</p></div>
    }
    else
    {
        <div class="thead" style="grid-template-columns:60px 1.4fr 1.4fr 120px"><span>ID</span><span>Адрес</span><span>Терминал кухни</span><span>Статус</span></div>
        <div class="rows">
        @foreach (var r in list)
        {
            <div class="row" style="grid-template-columns:60px 1.4fr 1.4fr 120px">
                <span class="mono dim">#@r.Id</span>
                <b>@r.Address</b>
                <div style="display:flex;align-items:center;gap:8px">
                    <img src="~/img/brand/st-qr.png" width="24" alt="" />
                    <a class="mono dim" style="font-size:12px;text-decoration:none" href="/Kitchen/@r.KitchenToken" target="_blank" title="Открыть терминал">/Kitchen/@r.KitchenToken.ToString()[..8]…</a>
                    <button class="btn sm ico ghost" type="button" title="Копировать" onclick="navigator.clipboard&&navigator.clipboard.writeText(location.origin+'/Kitchen/@r.KitchenToken')">⧉</button>
                    <form asp-action="RegenKitchen" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@r.Id" />
                        <button class="btn sm ico ghost" type="submit" title="Перевыпустить">↻</button>
                    </form>
                </div>
                <span class="badge gr"><i class="dot" style="width:5px;height:5px"></i>активна</span>
            </div>
        }
        </div>
    }
</section>

@section Scripts {
    <script>document.querySelectorAll('.fade-up').forEach(function(el,i){setTimeout(function(){el.classList.add('in');},50+i*60);});</script>
}
