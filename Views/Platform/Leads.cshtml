@{
    ViewData["Title"] = "Заявки";
    var leads = (List<SmartInventory.Models.Inventory.LeadRequest>)ViewBag.Leads;
    var statuses = new[] { "новая", "в работе", "доступ выдан" };
    string StatusBadge(string s) => s switch
    {
        "в работе" => "sv-badge-yellow",
        "доступ выдан" => "sv-badge-green",
        _ => "sv-badge-accent",
    };
}

<div class="sv-title-row fade-up">
    <div>
        <a class="sv-backlink" asp-controller="Inventory" asp-action="Index">← Назад</a>
        <div class="sv-kicker">Платформа · лиды</div>
        <h1 class="sv-page-title">Заявки с лендинга</h1>
        <div class="sv-page-sub mb-0">Обработка офлайн — Telegram и выдача доступов.</div>
    </div>
    <span class="sv-badge sv-badge-muted">@leads.Count заявок</span>
</div>

<div class="sv-card fade-up">
    @if (!leads.Any())
    {
        <div class="sv-empty"><img src="~/img/brand/chef-4-sm.png" alt="" /><p>Заявок пока нет.</p></div>
    }
    else
    {
        <div class="sv-table-wrap">
            <table class="sv-table">
                <thead><tr><th>Дата</th><th>Сеть</th><th>Контакт</th><th>Ресторанов</th><th>Статус</th><th></th></tr></thead>
                <tbody>
                @foreach (var l in leads)
                {
                    <tr>
                        <td class="sv-muted mono">@l.CreatedAt.ToLocalTime().ToString("dd.MM.yy HH:mm")</td>
                        <td><b>@l.NetworkName</b></td>
                        <td>@l.Contact</td>
                        <td>@l.RestaurantCount</td>
                        <td><span class="sv-badge @StatusBadge(l.Status)">@l.Status</span></td>
                        <td style="text-align:right">
                            <div class="d-flex gap-1" style="justify-content:flex-end">
                                @foreach (var s in statuses.Where(x => x != l.Status))
                                {
                                    <form asp-action="SetStatus" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@l.Id" />
                                        <input type="hidden" name="status" value="@s" />
                                        <button class="sv-chip" type="submit" style="height:26px;font-size:10px">@s</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {<script>document.querySelectorAll('.fade-up').forEach(function(el,i){setTimeout(function(){el.classList.add('in');},50+i*60);});</script>}
