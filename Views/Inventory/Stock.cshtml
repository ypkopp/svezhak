@{
    ViewData["Title"] = "Склад";
    var stock = (IEnumerable<dynamic>)ViewBag.Stock;
    var groups = (IEnumerable<dynamic>)ViewBag.Groups;
    var categories = (List<string>)ViewBag.Categories;
    var curCat = (string?)ViewBag.Category;
    bool expiringOnly = ViewBag.ExpiringOnly;
    var now = DateTime.UtcNow;
    var hot = stock.Count(b => b.ExpiresAt <= now.AddHours(12));
    var warm = stock.Count(b => b.ExpiresAt > now.AddHours(12) && b.ExpiresAt < now.AddHours(24));
    var ok = stock.Count(b => b.ExpiresAt >= now.AddHours(24));
    Func<string, string> catImg = c => c switch
    {
        "Рыба" => "cat-fish.png", "Мясо" => "cat-meat.png", "Овощи" => "cat-veg.png",
        "Молочное" => "cat-dairy.png", "Бакалея" => "cat-grocery.png", "Соусы" => "cat-sauce.png",
        _ => "st-fridge.png"
    };
}

<div class="ph rise">
    <div style="flex:1;min-width:0">
        <div class="eyebrow" style="margin-bottom:8px">Склад · FEFO</div>
        <h1 class="disp">Склад</h1>
        <p class="muted" style="margin:8px 0 0;font-size:14px">Партии сгруппированы по продукту — внутри по FEFO. Порчу списываем вручную.</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end">
        <a class="btn" asp-action="Deliveries">+ Приёмка</a>
    </div>
</div>

@if (TempData["StockOk"] is string sok) { <div class="sv-form-success mb-3">@sok</div> }
@if (TempData["StockError"] is string serr) { <div class="sv-form-alert mb-3">@serr</div> }

@* Сводка семафора *@
<section class="glass card rise" style="display:grid;grid-template-columns:repeat(3,1fr) 1.4fr;gap:14px;align-items:center">
    <div style="display:flex;align-items:center;gap:14px">
        <span style="width:40px;height:40px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff8,var(--rd) 45%,color-mix(in oklab,var(--rd) 40%,#000));box-shadow:0 0 22px -2px var(--rd)"></span>
        <div><div class="disp" style="font-size:26px;font-weight:700;color:var(--rd)">@hot</div><div class="eyebrow" style="font-size:9.5px">&lt;12 ч</div></div>
    </div>
    <div style="display:flex;align-items:center;gap:14px">
        <span style="width:40px;height:40px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff8,var(--ye) 45%,color-mix(in oklab,var(--ye) 40%,#000));box-shadow:0 0 22px -2px var(--ye)"></span>
        <div><div class="disp" style="font-size:26px;font-weight:700;color:var(--ye)">@warm</div><div class="eyebrow" style="font-size:9.5px">12–24 ч</div></div>
    </div>
    <div style="display:flex;align-items:center;gap:14px">
        <span style="width:40px;height:40px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff8,var(--gr) 45%,color-mix(in oklab,var(--gr) 40%,#000));box-shadow:0 0 22px -2px var(--gr)"></span>
        <div><div class="disp" style="font-size:26px;font-weight:700;color:var(--gr)">@ok</div><div class="eyebrow" style="font-size:9.5px">&gt;24 ч</div></div>
    </div>
    <div>
        <div style="display:flex;gap:4px;height:10px">
            <i style="flex:@Math.Max(1,hot);border-radius:6px;background:var(--rd);box-shadow:0 0 10px var(--rd)"></i>
            <i style="flex:@Math.Max(1,warm);border-radius:6px;background:var(--ye);box-shadow:0 0 10px var(--ye)"></i>
            <i style="flex:@Math.Max(1,ok);border-radius:6px;background:var(--gr);box-shadow:0 0 10px var(--gr)"></i>
        </div>
        <div class="dim" style="font-size:12px;margin-top:8px">@stock.Count() партий · первыми уходят те, что истекают раньше</div>
    </div>
</section>

<section class="glass card rise">
    <div class="card-h" style="flex-wrap:wrap">
        <span class="eyebrow">Партии на складе</span><span class="sp"></span>
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
            <a class="chip @(curCat == null ? "on" : "")" href="@Url.Action("Stock", new { expiringOnly })">Все<span class="n">@stock.Count()</span></a>
            @foreach (var c in categories)
            {
                <a class="chip @(curCat == c ? "on" : "")" href="@Url.Action("Stock", new { expiringOnly, category = c })"><img src="~/img/brand/@catImg(c)" alt="" />@c</a>
            }
            <label class="exp-box @(expiringOnly ? "on" : "")" title="Показать только горящие">
                <input type="checkbox" id="expToggle" @(expiringOnly ? "checked" : "") />
                <span class="exp-box-sq"></span>&lt;48 ч
            </label>
        </div>
    </div>

    @if (groups.Any())
    {
        <div style="display:flex;flex-direction:column;gap:14px">
        @foreach (var g in groups)
        {
            <div style="border-radius:18px;border:1px solid var(--stroke);padding:8px;background:color-mix(in oklab,var(--bg2) 35%,transparent)">
                <div style="display:flex;align-items:center;gap:10px;padding:6px 8px 10px">
                    <img src="~/img/brand/@catImg((string)g.Category)" width="26" height="26" alt="" />
                    <b style="font-size:14.5px">@g.Product</b>
                    <span class="badge">@g.Category</span>
                    <span style="flex:1"></span>
                    <span class="mono c-gr" style="font-weight:700">@($"{g.Total:0.##}") @g.Unit</span>
                </div>
                <div class="thead" style="grid-template-columns:90px 90px 1fr 110px 1.3fr 90px 44px;padding:0 14px 4px">
                    <span>Поставка</span><span>Остаток</span><span>Израсходовано</span><span>Приход</span><span>Свежесть</span><span>Срок</span><span></span>
                </div>
                <div class="rows">
                @foreach (var b in g.Batches)
                {
                    var used = b.QtyInitial > 0 ? 1 - (b.QtyRemaining / b.QtyInitial) : 0;
                    var freshH = (b.ExpiresAt - now).TotalHours;
                    var lit = Math.Max(1, (int)Math.Round(Math.Min(freshH, 72) / 72 * 18));
                    var isRed = b.ExpiresAt <= now.AddHours(12);
                    var fc = isRed ? "var(--rd)" : b.ExpiresAt < now.AddHours(24) ? "var(--ye)" : "var(--gr)";
                    <div class="row @b.RowClass" style="grid-template-columns:90px 90px 1fr 110px 1.3fr 90px 44px;@(isRed ? "background:color-mix(in oklab,var(--rd) 9%,transparent)" : "")">
                        <span class="badge">@b.Delivery</span>
                        <b class="mono" style="font-size:13px">@($"{b.QtyRemaining:0.##}") @g.Unit</b>
                        <div style="display:flex;align-items:center;gap:10px"><div class="bar" style="flex:1;color:var(--tx3)"><i style="width:@($"{used * 100:0}")%"></i></div><span class="dim mono" style="font-size:11px">@($"{used * 100:0}")%</span></div>
                        <span class="dim mono" style="font-size:12px">@b.ExpiresAt.ToLocalTime().ToString("dd.MM HH:mm")</span>
                        <div class="led" style="color:@fc">@for (var i = 0; i < 18; i++) { <i class="@(i < lit ? "on" : "")"></i> }</div>
                        <b class="mono" style="font-size:13px;color:@fc">@b.HoursText</b>
                        <button type="button" class="btn sm ico danger" title="Списать" data-wo
                            data-batch="@b.Id" data-name="@g.Product" data-unit="@g.Unit" data-max="@($"{b.QtyRemaining:0.###}")">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6"/></svg>
                        </button>
                    </div>
                }
                </div>
            </div>
        }
        </div>
    }
    else
    {
        <div class="sv-empty"><img src="~/img/brand/m-onigiri.png" alt="" style="height:110px" /><p>@(expiringOnly ? "Нет истекающих партий — склад свежий." : "Склад пуст — примите поставку.")</p></div>
    }
</section>

@* ===== Модалка ручного списания ===== *@
<div class="sv-modal-wrap" id="woModal" hidden>
    <div class="sv-modal" role="dialog" aria-modal="true" aria-label="Списать партию">
        <div class="sv-modal-head"><b>Списать партию</b><button type="button" id="woClose" aria-label="Закрыть">×</button></div>
        <form asp-action="WriteOff" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="batchId" id="woBatch" />
            <div class="sv-modal-body" style="text-align:left">
                <div class="sv-surface-caption mb-3">«<span id="woName"></span>» — спишется с остатка партии. Причина и количество ниже.</div>
                <label class="sv-label d-block mb-1">Количество (<span id="woUnit"></span>, макс <span id="woMax"></span>)</label>
                <input class="sv-input mb-3" type="number" name="qty" id="woQty" step="0.01" min="0.01" required />
                <label class="sv-label d-block mb-1">Причина</label>
                <select class="sv-select mb-3" name="reason">
                    <option value="manual">Порча / брак</option>
                    <option value="expired">Истёк срок</option>
                    <option value="manual">Прочее</option>
                </select>
                <label class="sv-label d-block mb-1">Комментарий</label>
                <input class="sv-input" type="text" name="comment" placeholder="например: помята упаковка" maxlength="300" />
            </div>
            <div class="modal-footer" style="border-top:1px solid #ffffff10;padding:14px 18px;display:flex;gap:10px;justify-content:flex-end">
                <button type="button" class="btn ghost" id="woCancel">Отмена</button>
                <button type="submit" class="btn danger">Списать</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
    document.getElementById('expToggle').addEventListener('change', function () {
        var cat = '@curCat';
        location.href = '@Url.Action("Stock", "Inventory")' + '?expiringOnly=' + this.checked + (cat ? '&category=' + encodeURIComponent(cat) : '');
    });
    var woModal = document.getElementById('woModal');
    document.querySelectorAll('[data-wo]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('woBatch').value = this.dataset.batch;
            document.getElementById('woName').textContent = this.dataset.name;
            document.getElementById('woUnit').textContent = this.dataset.unit;
            document.getElementById('woMax').textContent = this.dataset.max;
            var q = document.getElementById('woQty');
            q.value = this.dataset.max; q.max = this.dataset.max;
            woModal.hidden = false;
        });
    });
    ['woClose','woCancel'].forEach(function(id){var b=document.getElementById(id);if(b)b.addEventListener('click',function(){woModal.hidden=true;});});
    woModal.addEventListener('click',function(e){if(e.target===woModal)woModal.hidden=true;});
    document.querySelectorAll('.fade-up').forEach(function (el, i) { setTimeout(function () { el.classList.add('in'); }, 50 + i * 60); });
    </script>
    @await Html.PartialAsync("_InventoryRealtime")
}
