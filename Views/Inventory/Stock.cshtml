@{
    ViewData["Title"] = "Склад";
    var stock = (IEnumerable<dynamic>)ViewBag.Stock;
    bool expiringOnly = ViewBag.ExpiringOnly;
}

<h1 class="sv-page-title fade-up">Склад</h1>
<div class="d-flex justify-content-between align-items-center mb-3 fade-up">
    <p class="sv-page-sub mb-0">Остатки по партиям, отсортированы по сроку годности (FEFO)</p>
    <label class="sv-toggle">
        <input type="checkbox" id="expToggle" @(expiringOnly ? "checked" : "") />
        только истекающие (&lt;48ч)
    </label>
</div>

<div class="sv-card fade-up">
    @if (stock.Any())
    {
        <div class="sv-table-wrap">
        <table class="sv-table">
            <thead>
                <tr>
                    <th>Продукт</th><th>Поставка</th><th>Остаток</th>
                    <th>Изначально</th><th>Годен до</th><th>Осталось</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var b in stock)
            {
                <tr class="@b.RowClass">
                    <td><strong>@b.Product</strong></td>
                    <td><span class="sv-badge sv-badge-muted">@b.Delivery</span></td>
                    <td>@($"{b.QtyRemaining:0.##}") @b.Unit</td>
                    <td class="sv-muted">@($"{b.QtyInitial:0.##}") @b.Unit</td>
                    <td class="sv-muted">@b.ExpiresAt.ToLocalTime().ToString("dd.MM HH:mm")</td>
                    <td>@b.HoursText</td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }
    else
    {
        <div class="sv-empty"><img src="~/img/brand/chef-4-sm.png" alt=""/><p>@(expiringOnly ? "Нет истекающих партий." : "Склад пуст — примите поставку.")</p></div>
    }
</div>

@section Scripts {
<script>
    document.querySelectorAll('.fade-up').forEach(function(el, i){ setTimeout(function(){ el.classList.add('in'); }, 60 + i*75); });
    document.getElementById('expToggle').addEventListener('change', function () {
        window.location.href = '@Url.Action("Stock", "Inventory")' + (this.checked ? '?expiringOnly=true' : '');
    });
</script>
@await Html.PartialAsync("_InventoryRealtime")
}
