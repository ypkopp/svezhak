@using SmartInventory.Models.Inventory
@{
    ViewData["Title"] = "Поставки";
    var deliveries = (List<Delivery>)ViewBag.Deliveries;
    var products = (List<Product>)ViewBag.Products;
    var sums = (Dictionary<int, decimal>)ViewBag.DeliverySums;
}

<div class="ph rise">
    <div style="flex:1;min-width:0">
        <div class="eyebrow" style="margin-bottom:8px">Приёмка</div>
        <h1 class="disp">Поставки</h1>
        <p class="muted" style="margin:8px 0 0;font-size:14px">Приёмка новых партий и история поставок. Срок партии = сейчас + часы.</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end">
        <span class="dim mono" style="font-size:11px">CSV/XLSX · название;категория;ед;срок_ч;цена</span>
        <a class="btn sm" href="@Url.Action("ProductImportTemplate")" download>↓ шаблон CSV</a>
    </div>
</div>

@if (TempData["DeliveryOk"] is string ok) { <div class="sv-form-success mb-3 d-flex align-items-center gap-2"><img src="~/img/brand/m-lemon.png" style="width:38px" alt="" />@ok</div> }
@if (TempData["DeliveryError"] is string err) { <div class="sv-form-alert mb-3">@err</div> }

@* Полоса импорта *@
<section class="glass rise sv-import-bar" style="display:flex;align-items:center;gap:16px;padding:14px 18px;border-style:dashed">
    <img src="~/img/brand/st-box.png" style="width:38px" alt="" />
    <div style="flex:1"><b>Загрузить ассортимент</b><div class="dim" style="font-size:12.5px">База продуктов пополняется приёмкой или файлом — выберите CSV/XLSX</div></div>
    <form asp-action="ImportProductsPreview" method="post" enctype="multipart/form-data" class="d-flex align-items-center gap-2" style="display:flex;align-items:center;gap:8px">
        @Html.AntiForgeryToken()
        <label class="btn" style="cursor:pointer"><input type="file" name="file" accept=".csv,.xlsx,.xlsm,.xltx,.xltm" hidden required onchange="this.parentElement.querySelector('span').textContent=this.files[0]?this.files[0].name:'Выберите файл'" /><span>Выберите файл</span></label>
        <button type="submit" class="btn pri">Предпросмотр</button>
    </form>
</section>

@* ===== Предпросмотр импорта ===== *@
@if (ViewBag.ImportRows is List<SmartInventory.Services.ProductImportService.ImportRow> importRows && importRows.Any())
{
    <section class="glass card rise mb-3" style="border:1px solid color-mix(in oklab,var(--ac) 35%,transparent)">
        <div class="card-h" style="flex-wrap:wrap">
            <div><div class="ttl">Предпросмотр импорта</div><span class="dim" style="font-size:11px">поправь ошибки прямо в таблице, затем подтверди</span></div>
            <span class="sp"></span>
            <span class="badge @(importRows.Any(r => r.Errors.Count > 0) ? "ye" : "gr")">@importRows.Count(r => r.Errors.Count > 0) с ошибками / @importRows.Count</span>
        </div>
        <form asp-action="ImportProductsConfirm" method="post" id="importForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="importJson" id="importJson" value="" />
            <div class="sv-table-wrap" style="max-height:420px;overflow-y:auto">
                <table class="sv-table" id="importTable">
                    <thead><tr><th>Название</th><th>Категория</th><th>Ед.</th><th>Срок, ч</th><th>Цена, ₽</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var r in importRows)
                    {
                        <tr class="@(r.Errors.Count > 0 ? "sv-import-bad" : "")">
                            <td><input class="sv-input sv-imp" data-f="Name" value="@r.Name" /></td>
                            <td><input class="sv-input sv-imp" data-f="Category" value="@r.Category" /></td>
                            <td><input class="sv-input sv-imp" data-f="Unit" value="@r.Unit" style="width:64px" /></td>
                            <td><input class="sv-input sv-imp" data-f="ShelfHours" type="number" step="1" min="0" value="@($"{r.ShelfHours:0}")" style="width:78px" /></td>
                            <td><input class="sv-input sv-imp" data-f="PurchasePrice" type="number" step="0.01" min="0" value="@($"{r.PurchasePrice:0.##}")" style="width:88px" /></td>
                            <td>
                                @if (r.Errors.Count > 0)
                                {
                                    <span class="sv-badge sv-badge-red" title="@string.Join(", ", r.Errors)">@string.Join(", ", r.Errors)</span>
                                }
                                <button type="button" class="sv-wo-btn" data-delrow title="Убрать строку"><img src="~/img/brand/st-stop.png" alt="" /></button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="d-flex gap-2 mt-3 flex-wrap">
                <button type="submit" class="btn pri">Подтвердить импорт</button>
                <a class="btn ghost" asp-action="Deliveries">Отменить</a>
                <span class="dim" style="font-size:11px;align-self:center">строки с ошибками будут пропущены</span>
            </div>
        </form>
    </section>
}

<div class="grid" style="grid-template-columns:1fr 1.15fr;align-items:start">
    <section class="glass card rise" style="position:sticky;top:90px">
        <div class="card-h">
            <img src="~/img/brand/st-truck.png" style="width:32px" alt="" />
            <span class="ttl">Приёмка поставки</span><span class="sp"></span>
            <span class="mono dim" style="font-size:12px">сумма: <b class="c-gr" id="delivSum">0 ₽</b></span>
        </div>
        <form asp-action="Deliveries" method="post">
            @Html.AntiForgeryToken()
            <div class="field" style="margin-bottom:16px"><label>Номер поставки</label><input name="number" class="inp mono" placeholder="D-004" required /></div>
            <div class="field"><label>Позиции</label></div>
            <div id="deliveryLines" style="margin-top:8px"></div>
            <button type="button" id="addLine" class="btn sm" style="margin-top:12px;color:var(--tx)">+ строка</button>
            <button type="submit" class="btn pri lg" style="width:100%;margin-top:18px">Принять поставку</button>
        </form>
    </section>

    <section class="glass card rise">
        <div class="card-h" style="flex-wrap:wrap">
            <span class="eyebrow">Журнал поставок</span><span class="sp"></span>
            <span class="badge">@deliveries.Count записей</span>
        </div>
        @if (((List<DateTime>)ViewBag.Months).Count > 1)
        {
            <div class="d-flex gap-1 flex-wrap mb-3">
                @foreach (var m in (List<DateTime>)ViewBag.Months)
                {
                    var isCur = m == (DateTime)ViewBag.ActiveMonth;
                    <a class="chip @(isCur ? "on" : "")" href="@Url.Action("Deliveries", new { month = m.ToString("yyyy-MM") })">@m.ToString("MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))</a>
                }
            </div>
        }
        @if (deliveries.Any())
        {
            <div style="position:relative;padding-left:22px">
                <i style="position:absolute;left:6px;top:8px;bottom:8px;width:2px;background:linear-gradient(var(--gr),var(--ac),transparent)"></i>
                @foreach (var d in deliveries)
                {
                    <div style="position:relative;padding:4px 0 20px">
                        <i style="position:absolute;left:-21px;top:9px;width:12px;height:12px;border-radius:50%;border:2px solid var(--gr);background:var(--bg);box-shadow:0 0 10px var(--gr)"></i>
                        <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
                            <b class="mono" style="font-size:14px">@d.Number</b>
                            <span class="badge">поставка</span>
                            <span style="flex:1"></span>
                            <span class="dim mono" style="font-size:12px">@d.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                            <b class="mono c-gr">@($"{sums[d.Id]:N0} ₽")</b>
                        </div>
                        <div style="display:flex;flex-wrap:wrap;gap:6px">
                            @foreach (var b in d.Batches)
                            {
                                <span class="chip" style="height:28px;font-size:12px;cursor:default"><i class="dot c-gr" style="width:5px;height:5px"></i>@b.Product?.Name <b class="mono">@($"{b.QtyInitial:0.##}") @b.Product?.Unit</b></span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="sv-empty"><img src="~/img/brand/m-onigiri.png" alt="" style="height:110px" /><p>Поставок ещё не было — самая первая приёмка появится здесь.</p></div>
        }
    </section>
</div>

@section Scripts {
    <script>
    const products = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(products.Select(p => new { p.Id, p.Name, p.Unit, p.Category, price = p.PurchasePrice })));
    const lines = document.getElementById('deliveryLines');
    function updateSum() {
        let sum = 0;
        lines.querySelectorAll('.sv-dynamic-line').forEach(row => {
            const nameIn = row.querySelector('[name=productName]'), qty = Number(row.querySelector('input[name=qty]').value || 0);
            const p = products.find(x => x.Name.toLowerCase() === nameIn.value.trim().toLowerCase());
            if (p && qty > 0) sum += qty * p.price;
        });
        document.getElementById('delivSum').textContent = new Intl.NumberFormat('ru-RU',{maximumFractionDigits:0}).format(sum) + ' ₽';
    }

    const prodList = document.createElement('datalist');
    prodList.id = 'svProductList';
    products.forEach(p => { const o = document.createElement('option'); o.value = p.Name; o.dataset.id = p.Id; prodList.appendChild(o); });
    document.body.appendChild(prodList);

    function addLine() {
        const row = document.createElement('div');
        row.className = 'sv-dynamic-line';
        row.innerHTML = `
            <div class="sv-prod-field">
                <input class="sv-input" name="productName" list="svProductList" placeholder="продукт…" autocomplete="off" required />
                <input type="hidden" name="productId" value="" />
                <div class="sv-new-prod" hidden>
                    <input class="sv-input sv-np" data-f="ncat" placeholder="категория" />
                    <input class="sv-input sv-np" data-f="nunit" placeholder="ед." style="width:60px" />
                </div>
            </div>
            <input name="qty" type="number" step="0.01" min="0.01" class="sv-input" placeholder="кол-во" required />
            <input name="shelfHours" type="number" step="1" min="1" class="sv-input" placeholder="часов" required />
            <button type="button" class="btn sm ico" aria-label="Удалить" onclick="this.parentElement.remove();updateSum()">×</button>`;
        lines.appendChild(row);

        const nameIn = row.querySelector('[name=productName]');
        const idIn = row.querySelector('[name=productId]');
        const newBox = row.querySelector('.sv-new-prod');
        const ncat = newBox.querySelector('[data-f=ncat]');
        const nunit = newBox.querySelector('[data-f=nunit]');

        nameIn.addEventListener('input', function () {
            const match = products.find(p => p.Name.toLowerCase() === this.value.trim().toLowerCase());
            if (match) {
                idIn.value = match.Id;
                newBox.hidden = true;
                ncat.removeAttribute('required'); nunit.removeAttribute('required');
                row.querySelector('[name=qty]').placeholder = 'кол-во, ' + match.Unit;
            } else {
                idIn.value = '';
                const isNew = this.value.trim().length > 0;
                newBox.hidden = !isNew;
                if (isNew) { ncat.setAttribute('required',''); nunit.setAttribute('required',''); }
                row.querySelector('[name=qty]').placeholder = 'кол-во';
            }
            updateSum();
        });

        row.querySelectorAll('input').forEach(x => x.addEventListener('input', updateSum));
    }

    var importForm = document.getElementById('importForm');
    if (importForm) {
        document.querySelectorAll('[data-delrow]').forEach(function (b) {
            b.addEventListener('click', function () { this.closest('tr').remove(); });
        });
        importForm.addEventListener('submit', function () {
            var rows = [];
            document.querySelectorAll('#importTable tbody tr').forEach(function (tr) {
                var get = f => { var el = tr.querySelector('[data-f="' + f + '"]'); return el ? el.value.trim() : ''; };
                rows.push({
                    Name: get('Name'), Category: get('Category'), Unit: get('Unit'),
                    ShelfHours: parseFloat(get('ShelfHours')) || 0,
                    PurchasePrice: parseFloat(get('PurchasePrice')) || 0
                });
            });
            document.getElementById('importJson').value = JSON.stringify(rows);
        });
    }

    document.getElementById('addLine').addEventListener('click', addLine);
    addLine();
    document.querySelectorAll('.fade-up').forEach(function (el, i) { setTimeout(function () { el.classList.add('in'); }, 50 + i * 60); });
    </script>
    @await Html.PartialAsync("_InventoryRealtime")
}
