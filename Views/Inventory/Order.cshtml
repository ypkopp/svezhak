@using SmartInventory.Models.Inventory
@{
    ViewData["Title"] = "Заказ";
    var dishes = (List<Dish>)ViewBag.Dishes;
    var journal = (IEnumerable<dynamic>)ViewBag.Journal;
    var categories = new[] { "Все", "Роллы", "Салаты", "Пицца", "Горячее", "Боулы" };
}

<div class="sv-title-row fade-up">
    <div>
        <h1 class="sv-page-title">Оформление заказа</h1>
        <div class="sv-page-sub mb-0">При приёме списание идёт по FEFO — самые ранние партии первыми.</div>
    </div>
</div>

@if (TempData["OrderOk"] is string ok)
{
    <div class="sv-form-success mb-3 d-flex align-items-center gap-2"><img src="~/img/brand/chef-1-sm.png" style="width:38px" alt="" /> @ok</div>
}
@if (TempData["OrderError"] is string err)
{
    <div class="sv-form-alert mb-3">
        <div class="d-flex align-items-center gap-2 mb-1"><img src="~/img/brand/chef-3-sm.png" style="width:38px" alt="" /><strong>Заказ отклонён — дефицит:</strong></div>
        <ul class="mb-0 mt-1">@foreach (var line in err.Split(';')) { <li>@line.Trim()</li> }</ul>
    </div>
}

<div class="sv-order-layout">
    <section class="sv-card fade-up">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="sv-section-title mb-0">Меню</div>
            <div class="sv-order-cats">
                @foreach (var c in categories)
                {
                    <button type="button" class="@(c == "Все" ? "active" : "")" data-cat="@c">@c</button>
                }
            </div>
        </div>
        <form asp-action="Order" method="post" id="orderForm">
            @Html.AntiForgeryToken()
            <div class="sv-order-menu">
                @foreach (var d in dishes)
                {
                    var category = d.Name.Contains("Ролл") ? "Роллы" : d.Name.Contains("Салат") ? "Салаты" : d.Name.Contains("Пицца") ? "Пицца" : d.Name.Contains("Поке") || d.Name.Contains("боул") ? "Боулы" : "Горячее";
                    <div class="sv-menu-card" data-cat="@category">
                        <strong>@d.Name</strong>
                        <div class="sv-menu-meta"><span>@($"{d.Price:0}") ₽</span><span>заказ</span></div>
                        <div class="sv-qty-control">
                            <button type="button" data-delta="-1" aria-label="Меньше">−</button>
                            <input type="number" name="qty" value="0" min="0" data-dish-id="@d.Id" />
                            <button type="button" data-delta="1" aria-label="Больше">+</button>
                        </div>
                        <input type="hidden" name="dishId" value="@d.Id" />
                    </div>
                }
            </div>
            <div class="sv-order-submitbar">
                <div><div class="sv-kicker">Позиций</div><b id="orderCount">0</b></div>
                <div><div class="sv-kicker">Сумма</div><b id="orderSum">0 ₽</b></div>
                <span class="sv-muted flex-grow-1">Списание по FEFO — сначала самые ранние партии</span>
                <button class="btn-sv-primary" type="submit" id="orderSubmit">Отправить на кухню →</button>
            </div>
        </form>
    </section>

    <section class="sv-card fade-up">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="sv-section-title mb-0">Журнал заказов</div>
            <span class="sv-ai-note"><b style="color:var(--gr)">@journal.Count(x => x.Status == "accepted")</b> принято · <b style="color:var(--rd)">@journal.Count(x => x.Status != "accepted")</b> отклонено</span>
        </div>
        <div class="sv-spark-bars" aria-hidden="true">
            @foreach (var o in journal.Take(22).Reverse())
            {
                var h = Math.Max(8, Math.Min(42, o.ItemCount * 8));
                <i style="height:@(h)px;background:@(o.Status == "accepted" ? "#48BB78" : "#F56565");box-shadow:0 0 6px @(o.Status == "accepted" ? "#48BB78" : "#F56565")"></i>
            }
        </div>
        <div>
            @if (journal.Any())
            {
                @foreach (var o in journal)
                {
                    <div class="sv-journal-row">
                        <span class="sv-muted">#@o.Id</span>
                        <span class="sv-badge @(o.Status == "accepted" ? "sv-badge-green" : "sv-badge-red")">@(o.Status == "accepted" ? "принят" : "отклонён")</span>
                        <span>@o.ItemCount поз.</span>
                        <span class="sv-muted">@o.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
                    </div>
                }
            }
            else
            {
                <div class="sv-empty"><img src="~/img/brand/chef-4-sm.png" alt="" /><p>Заказов ещё не было.</p></div>
            }
        </div>
    </section>
</div>

@section Scripts {
    <script>
    const form = document.getElementById('orderForm');
    const inputs = [...form.querySelectorAll('input[name=qty]')];
    const prices = {@Html.Raw("{" + string.Join(",", dishes.Select(d => $"\"{d.Id}\":{d.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)}")) + "}")};
    function updateTotals() {
        let count = 0, sum = 0;
        inputs.forEach(input => {
            const qty = Math.max(0, Number(input.value || 0));
            count += qty;
            sum += qty * (prices[input.dataset.dishId] || 0);
            input.closest('.sv-menu-card').classList.toggle('is-selected', qty > 0);
        });
        document.getElementById('orderCount').textContent = count;
        document.getElementById('orderSum').textContent = new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 0 }).format(sum) + ' ₽';
        document.getElementById('orderSubmit').disabled = count === 0;
    }
    form.querySelectorAll('button[data-delta]').forEach(button => button.addEventListener('click', function () {
        const input = this.parentElement.querySelector('input');
        input.value = Math.max(0, Number(input.value || 0) + Number(this.dataset.delta));
        updateTotals();
    }));
    inputs.forEach(input => input.addEventListener('input', updateTotals));
    document.querySelectorAll('.sv-order-cats button').forEach(button => button.addEventListener('click', function () {
        document.querySelectorAll('.sv-order-cats button').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        const cat = this.dataset.cat;
        document.querySelectorAll('.sv-menu-card').forEach(card => card.style.display = cat === 'Все' || card.dataset.cat === cat ? '' : 'none');
    }));
    updateTotals();
    document.querySelectorAll('.fade-up').forEach(function (el, i) { setTimeout(function () { el.classList.add('in'); }, 50 + i * 60); });
    </script>
    @await Html.PartialAsync("_InventoryRealtime")
}
