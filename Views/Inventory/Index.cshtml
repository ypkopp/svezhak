@{
    ViewData["Title"] = "Дашборд";
    var recommended = (IEnumerable<dynamic>)ViewBag.Recommended;
    var now = (DateTime)ViewBag.Now;
    var hasAlert = (bool)ViewBag.HasAlert;
    int threat = ViewBag.ThreatCount, stopCount = ViewBag.KpiStopList;
    var ai = ViewBag.AiSummary as SmartInventory.Services.AdvisorService.SummaryResult;
    Func<string, string> sevColor = s => s == "high" ? "var(--rd)" : s == "medium" ? "var(--ye)" : "var(--mut)";
}

@* ============ HERO (v6): 2 колонки — тревога + Спираль свежести ============ *@
<section class="glass sv-hero6 fade-up">
    <div class="sv-hero6-copy">
        <div style="display:flex;gap:8px;align-items:center">
            <span class="badge rd"><i class="dot pulse" style="width:6px;height:6px"></i>тревога</span>
            <span class="eyebrow">обновлено @now.ToLocalTime().ToString("HH:mm") · SignalR</span>
        </div>
        <h1 class="disp" style="margin:0;font-size:46px;line-height:1;font-weight:700">Под угрозой<br /><span class="grad-tx">@threat партии</span></h1>
        <p class="muted" style="margin:0;max-width:470px;font-size:15px">
            @if (ViewBag.NextExpiryProduct is string np)
            {
                @:«@np» уходит через <b class="c-rd">@($"{(double)ViewBag.NextExpiryHours:0.#}") ч</b> — это @($"{(decimal)ViewBag.NextExpiryQty:0.##}") @ViewBag.NextExpiryUnit и ~@($"{(decimal)ViewBag.NextExpiryRub:N0}") ₽ себестоимости. Лимо уже нашла блюда, которые его съедят.
            }
            else
            {
                @:Все партии свежие — срочных угроз нет. Склад под контролем, FEFO следит за порядком списаний.
            }
        </p>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
            <a class="btn pri lg" asp-action="StopList"><img src="~/img/brand/st-hot.png" style="width:20px;height:20px;mix-blend-mode:lighten" alt="" />Включить @ViewBag.KpiHotOffers hot offers</a>
            <a class="btn lg" asp-action="Stock">Открыть склад <span style="opacity:.7">→</span></a>
        </div>
        <div style="flex:1"></div>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px">
            <div class="sv-kpi6"><div class="eyebrow" style="font-size:9px">позиций</div><div class="mono" data-count="@ViewBag.KpiPositions" style="font-size:24px;font-weight:700;margin-top:8px;color:var(--gr)">@ViewBag.KpiPositions</div></div>
            <div class="sv-kpi6"><div class="eyebrow" style="font-size:9px">истекает &lt;24 ч</div><div class="mono" data-count="@ViewBag.KpiExpiring" style="font-size:24px;font-weight:700;margin-top:8px;color:var(--rd)">@ViewBag.KpiExpiring</div></div>
            <div class="sv-kpi6"><div class="eyebrow" style="font-size:9px">в стоп-листе</div><div class="mono" data-count="@stopCount" style="font-size:24px;font-weight:700;margin-top:8px;color:var(--ye)">@stopCount</div></div>
            <div class="sv-kpi6"><div class="eyebrow" style="font-size:9px">до конца смены</div><div class="mono" id="shiftCountdown" style="font-size:24px;font-weight:700;margin-top:8px;color:var(--ac)">--:--</div></div>
        </div>
    </div>
    <div class="sv-hero6-spiral">
        <div class="eyebrow" style="position:absolute;left:20px;top:20px">Спираль свежести · 72 ч</div>
        <div id="heroRadar"></div>
        <div class="eyebrow" style="position:absolute;right:18px;bottom:18px;display:flex;gap:10px">
            <span class="c-rd">● &lt;12</span><span class="c-ye">● 12–24</span><span class="c-gr">● &gt;24</span>
        </div>
    </div>
</section>

@if (TempData["OrderOk"] is string ok) { <div class="sv-alert sv-alert-success mb-3">@ok</div> }

@* ============ ИИ-анализ смены — ПОСЛЕДНИЙ сохранённый авто-анализ + лента ============ *@
@{
    var saved = ViewBag.AiInsight as SmartInventory.Models.Inventory.AiInsight;
    var savedChips = ViewBag.AiChips as List<SmartInventory.Controllers.InventoryController.AiChip> ?? [];
    var feed = ViewBag.AiFeed as List<SmartInventory.Models.Inventory.AiInsight> ?? [];
    // Без дублей: «продать срочно» живёт в карточке hot-offers — в чипы сводки не берём
    // Нормализуем в один тип: (Category,Title,Severity,ActionUrl)
    var dashChips = (saved is not null
            ? savedChips.Select(h => (h.Category, h.Title, h.Severity, h.ActionUrl))
            : (ai?.Highlights ?? []).Select(h => (h.Category, h.Title, h.Severity, h.ActionUrl)))
        .Where(h => h.Category != "продать срочно").Take(3).ToList();
    var aiText = saved?.Text ?? ai?.Text ?? "Анализ формируется — фоновый сервис ещё не писал снапшот.";
    var aiTime = saved?.CreatedAt ?? ai?.GeneratedAtUtc ?? DateTime.UtcNow;
    var aiIsAi = saved?.UsedAi ?? ai?.UsedAi ?? false;
}
<section class="sv-card sv-ai-block fade-up">
    <div class="sv-ai-layout">
        <img class="sv-ai-chef" src="~/img/brand/m-avo.png" alt="Юзу" />
        <div class="sv-ai-body">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <div class="sv-section-title mb-0" style="color:var(--a1)">ИИ-анализ смены</div>
                <div class="d-flex align-items-center gap-2">
                    <span class="sv-ai-note">обновлено @aiTime.ToLocalTime().ToString("HH:mm")</span>
                    <span class="sv-badge @(aiIsAi ? "sv-badge-accent" : "sv-badge-muted")">@(aiIsAi ? "ИИ" : "локальные правила")</span>
                </div>
            </div>
            <p class="sv-ai-text">@aiText</p>
            @if (dashChips.Count > 0)
            {
                <div class="sv-ai-chips">
                    @foreach (var h in dashChips)
                    {
                        <a class="sv-ai-chip" href="@h.ActionUrl" style="--c:@sevColor(h.Severity)" title="">
                            <span class="sv-ai-chip-dot"></span>@h.Title <em>@h.Category</em>
                        </a>
                    }
                </div>
            }
            @if (feed.Count > 1)
            {
                <details class="sv-ai-feed">
                    <summary>Лента анализа · @feed.Count</summary>
                    @foreach (var f in feed.Skip(1))
                    {
                        <div class="sv-ai-feed-row"><span class="sv-muted mono">@f.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")</span><span>@f.Text</span></div>
                    }
                </details>
            }
        </div>
    </div>
</section>

@* ============ Путь продукта (v4 FlowStrip) ============ *@
<div class="sv-flow-card fade-up">
    <div class="sv-flow">
        <img src="~/img/brand/info-flow.png" asp-append-version="true" alt="Путь продукта" />
        <div class="sv-flow-fade"></div>
        <div class="sv-flow-pin" style="--pin:var(--gr);left:14%;top:28%"><span>01 · Приёмка</span><b>2</b><small>поставки сегодня</small></div>
        <div class="sv-flow-pin" style="--pin:var(--ye);left:50%;top:13%"><span>02 · Холодильник</span><b>@ViewBag.KpiPositions</b><small>позиций</small></div>
        <div class="sv-flow-pin" style="--pin:var(--or);left:86%;top:32%"><span>03 · Кухня</span><b>@ViewBag.KpiExpiring</b><small>горит сейчас</small></div>
        <div class="sv-flow-loss"><img src="~/img/brand/st-hourglass.png" alt="" /><div class="sv-stat-chip"><b>18,6 кг</b><span>утекло · 6,9%</span></div></div>
    </div>
</div>

@* ============ Река свежести (кастомная — ECharts) ============ *@
<div class="sv-river fade-up">
    <div class="sv-river-head">
        <div>
            <div class="sv-k">Река свежести · 72 ч вперёд</div>
            <div class="sv-river-title">Каждая партия — точка на оси времени. <span>Чем левее, тем срочнее.</span></div>
        </div>
        <div class="sv-legend"><span style="--c:#F56565">&lt; 12 ч</span><span style="--c:#ECC94B">12–24 ч</span><span style="--c:#48BB78">&gt; 24 ч</span></div>
    </div>
    <div class="sv-chart-wrap" id="riverWrap">
        <div id="riverSkel" class="sv-chart-skel"></div>
        <div id="riverChart" class="sv-chart" style="display:none"></div>
        <div class="sv-chart-empty" id="riverEmpty">Партий с живым сроком нет.</div>
        <div class="sv-chart-error" id="riverError"></div>
    </div>
</div>

@* ============ Осциллограф + LED-водопад (split 1.3 / 1) ============ *@
<div class="sv-grid-12">
    <div class="sv-card sv-col-7 fade-up">
        <div class="sv-section-title">Осциллограф заказов · 24 ч <span class="sv-live-dot"></span></div>
        <div class="sv-chart-hint">Сегодня сплошной, вчера пунктиром. Луч-развёртка бежит по графику.</div>
        <div class="sv-osc-wrap" id="orderOsc"></div>
    </div>
    <div class="sv-card sv-col-5 fade-up">
        <div class="sv-section-title">Масса склада · сегодня</div>
        <div class="sv-chart-hint">LED-ячейки: утро → по заказам → просрочка → сейчас.</div>
        <div id="massWf"></div>
        <div class="sv-wf3" id="massWfFoot"><span class="sv-muted">Списаний за сегодня не было.</span></div>
    </div>
    <div class="sv-card sv-col-7 fade-up">
        <div class="sv-section-title">Прогноз стоп-листа</div>
        <div class="sv-chart-hint">При текущем расходе эти блюда встанут в стоп-лист через N дней.</div>
        <div class="sv-chart-wrap"><div id="forecastSkel" class="sv-chart-skel"></div><div id="stopForecast" class="sv-chart" style="display:none"></div><div class="sv-chart-empty" id="forecastEmpty">Прогноз не строится — история заказов пуста.</div><div class="sv-chart-error" id="forecastError"></div></div>
    </div>
    <div class="sv-card sv-col-5 fade-up">
        <div class="sv-section-title" style="color:var(--rd)">Риск списания в ₽</div>
        <div class="sv-chart-hint">Сколько ₽ сгорит, если ничего не продать — по закупочной себестоимости партий.</div>
        <div class="sv-risk-total" id="riskTotal">—</div>
        <div id="riskList" class="sv-risk-list"></div>
    </div>
    <div class="sv-card sv-col-7 fade-up">
        <div class="sv-section-title">Доля потерь · 30 дней</div>
        <div class="sv-chart-hint">Соотношение проданного, списанного и просроченного.</div>
        <div class="sv-chart-wrap"><div id="lossSkel" class="sv-chart-skel"></div><div id="lossShare" class="sv-chart" style="display:none"></div><div class="sv-chart-empty" id="lossEmpty">Нет данных для расчёта.</div><div class="sv-chart-error" id="lossError"></div></div>
    </div>
    <div class="sv-card sv-col-5 fade-up">
        <div class="sv-section-title" style="color:var(--a1)"><img src="~/img/brand/st-hot.png" style="width:14px;height:14px;mix-blend-mode:lighten;vertical-align:-2px;margin-right:2px" alt="" /> Hot offers · топ-5</div>
        @foreach (var (r, i) in recommended.Take(5).Select((x, i) => (x, i)))
        {
            var col = r.HoursLeft < 12 ? "#F56565" : r.HoursLeft < 24 ? "#ED8936" : "#48BB78";
            <div class="sv-rec">
                <div><b>@r.Name</b><span class="sv-pill" style="color:@col;margin-left:auto">@($"{r.HoursLeft:0.#}") ч</span></div>
            </div>
        }
        @if (!recommended.Any())
        {
            <div class="sv-empty"><img src="~/img/brand/chef-4-sm.png" alt="" /><p>Все блюда в запасе.</p></div>
        }
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
<script src="~/js/svezhak-charts.js" asp-append-version="true"></script>
<script src="~/js/svezhak-proto.js" asp-append-version="true"></script>
<script>
(function(){
    function refreshDash(){
        // Каждый виджет дашборда перезапрашивает свои данные (событие или страховка 60с)
        SvCharts.initAll({
            river: { el:'riverChart', skel:'riverSkel', empty:'riverEmpty', error:'riverError', url:'@Url.Action("ChartDataRiver","Inventory")' },
            stopForecast: { el:'stopForecast', skel:'forecastSkel', empty:'forecastEmpty', error:'forecastError', url:'@Url.Action("StopForecast","InventoryAnalytics")' },
            lossShare: { el:'lossShare', skel:'lossSkel', empty:'lossEmpty', error:'lossError', url:'@Url.Action("LossShare","InventoryAnalytics")' }
        });
        SvProto.spiral('heroRadar', '@Url.Action("ChartDataRiver","Inventory")');
        SvProto.osc('orderOsc', '@Url.Action("ChartDataOrderPulse","Inventory")');
        SvProto.waterfall('massWf', '@Url.Action("ChartDataWaterfall","Inventory")');
        fetch('@Url.Action("WriteoffRisk","InventoryAnalytics")').then(r=>r.json()).then(d=>{
            document.getElementById('riskTotal').textContent = (d.totalRiskRub||0).toLocaleString('ru-RU',{maximumFractionDigits:0}) + ' ₽';
            var list=(d.batches||[]).slice(0,6).map(b=>{
                var c=b.hoursLeft<12?'var(--rd)':b.hoursLeft<24?'var(--or)':'var(--mut)';
                return '<div class="sv-risk-row"><b>'+b.product+'</b><span class="sv-muted">'+b.delivery+' · '+b.hoursLeft+' ч</span><b style="color:'+c+'">'+b.estimatedValueRub.toLocaleString('ru-RU',{maximumFractionDigits:0})+' ₽</b></div>';
            }).join('');
            document.getElementById('riskList').innerHTML=list||'<div class="sv-muted" style="padding:12px 0">Риска нет — всё свежее.</div>';
        }).catch(function(){document.getElementById('riskList').innerHTML='';});
    }
    refreshDash();
    if (window.SvRealtime) SvRealtime.subscribe('dash', refreshDash);

    // До конца смены — живой обратный отсчёт
    (function () {
        var end = '@(ViewBag.ShiftEndLocal?.ToString("HH\\:mm") ?? "")';
        var node = document.getElementById('shiftCountdown');
        function tick() {
            if (!end) { node.textContent = 'смена не задана'; return; }
            var parts = end.split(':'), now = new Date(), t = new Date();
            t.setHours(+parts[0], +parts[1], 0, 0);
            var ms = t - now;
            if (ms <= 0) { node.textContent = 'смена завершена'; return; }
            var h = Math.floor(ms / 3600000), m = Math.floor(ms % 3600000 / 60000), s = Math.floor(ms % 60000 / 1000);
            node.textContent = (h < 10 ? '0' + h : h) + ':' + (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s);
        }
        tick(); setInterval(tick, 1000);
    })();
})();
</script>
@await Html.PartialAsync("_InventoryRealtime")
}
