@model SmartInventory.Services.AdvisorService.InsightsResult
@{
    ViewData["Title"] = "Советник";
    Func<string, string> catColor = c => c switch
    {
        "продать срочно" => "var(--rd)",
        "заказать" => "var(--gr)",
        "списать" => "var(--ye)",
        _ => "var(--mut)"
    };
    Func<string, string> catIcon = c => c switch
    {
        "продать срочно" => "st-hot.png",
        "заказать" => "st-box.png",
        "списать" => "st-hourglass.png",
        _ => "st-stop.png"
    };
}

<div class="sv-title-row fade-up">
    <div>
        <div class="sv-kicker">Юзу + локальные правила инвентаря</div>
        <h1 class="sv-page-title">Советник склада</h1>
        <div class="sv-page-sub mb-0">Инсайты по горящим партиям, стоп-листу, расходу и остаткам.</div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <img src="~/img/brand/m3-avo.png" style="width:36px" alt="Юзу" />
        <span class="sv-badge @(Model.UsedAi ? "sv-badge-accent" : "sv-badge-muted")">@(Model.UsedAi ? "AI-инсайты" : "локальные правила")</span>
        <span class="sv-ai-note">обновлено @Model.GeneratedAtUtc.ToLocalTime().ToString("HH:mm")</span>
    </div>
</div>

@{
    var cats = new[] {
        ("продать срочно", "Продать срочно", "🔥", "var(--rd)"),
        ("заказать", "Заказать", "📦", "var(--gr)"),
        ("списать", "Списать", "🗑", "var(--ye)"),
        ("риски", "Риски", "⚠", "var(--mut)")
    };
    var sevOrd = new Dictionary<string,int>{{"high",0},{"medium",1},{"low",2}};
}
@if (!Model.Insights.Any())
{
    <div class="sv-card fade-up">
        <div class="sv-empty"><img src="~/img/brand/chef-4-sm.png" alt="" /><p>Сейчас нет срочных рекомендаций — склад под контролем.</p></div>
    </div>
}
else
{
    @* Фильтр-чипы со счётчиками *@
    <div class="d-flex flex-wrap gap-1 mb-3" id="advFilters">
        <button type="button" class="sv-chip active" data-adv-filter="all">Все @Model.Insights.Count()</button>
        @foreach (var c in cats)
        {
            var n = Model.Insights.Count(i => i.Category == c.Item1);
            <button type="button" class="sv-chip" data-adv-filter="@c.Item1">@c.Item3 @c.Item2 <span style="color:@c.Item4">@n</span></button>
        }
    </div>

    @foreach (var c in cats)
    {
        var items = Model.Insights.Where(i => i.Category == c.Item1)
            .OrderBy(i => sevOrd.GetValueOrDefault(i.Severity ?? "low", 3)).ToList();
        if (!items.Any()) continue;
        <div class="sv-adv-section" data-adv-section="@c.Item1">
            <div class="sv-adv-section-h" style="color:@c.Item4">@c.Item3 @c.Item2 <span class="sv-muted" style="font-weight:600">· @items.Count</span></div>
            <div class="sv-advisor-grid">
                @foreach (var item in items)
                {
                    <article class="sv-adv-card sv-hover-card fade-up" data-severity="@item.Severity">
                        <img class="sv-adv-ic" src="~/img/brand/@catIcon(item.Category)" alt="" />
                        <div class="sv-adv-body">
                            <div class="sv-adv-head">
                                <div class="sv-adv-cat" style="color:@c.Item4">@c.Item2</div>
                                <span class="sv-badge @(item.Severity == "high" ? "sv-badge-red" : item.Severity == "medium" ? "sv-badge-yellow" : "sv-badge-green")">@item.Severity</span>
                            </div>
                            <h3 class="sv-adv-title">@item.Title</h3>
                            <p class="sv-adv-tx">@item.Explanation</p>
                            <a class="sv-adv-btn" href="@item.ActionUrl" style="--c:@c.Item4">@item.ActionLabel →</a>
                        </div>
                    </article>
                }
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        // Фильтр по категориям — показывает нужные секции
        document.querySelectorAll('[data-adv-filter]').forEach(function(b){
            b.addEventListener('click',function(){
                document.querySelectorAll('[data-adv-filter]').forEach(x=>x.classList.remove('active'));
                this.classList.add('active');
                var f=this.dataset.advFilter;
                document.querySelectorAll('[data-adv-section]').forEach(function(s){
                    s.style.display=(f==='all'||s.dataset.advSection===f)?'':'none';
                });
            });
        });
        document.querySelectorAll('.fade-up').forEach(function (el, i) { setTimeout(function () { el.classList.add('in'); }, 50 + i * 60); });
    </script>
    @await Html.PartialAsync("_InventoryRealtime")
}
