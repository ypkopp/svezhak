@{
    ViewData["Title"] = "Аналитика периода";
    var deadStock = (IEnumerable<dynamic>)ViewBag.DeadStock;
    var movers = (IEnumerable<dynamic>)ViewBag.Movers;
    var period = (string)ViewBag.Period;
    var periodLabel = (string)ViewBag.PeriodLabel;
}

<div class="ph rise">
    <div style="flex:1;min-width:0">
        <div class="eyebrow" style="margin-bottom:8px">Отчёт</div>
        <h1 class="disp">Аналитика · @periodLabel</h1>
        <p class="muted" style="margin:8px 0 0;font-size:14px">Неликвиды (доля просрочки от поступлений) и ходовые товары.</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end">
        <div class="seg" id="periodSeg">
            @foreach (var p in new[]{("7","7 дней"),("30","30 дней"),("90","90 дней"),("all","Всё время")})
            {
                <button type="button" class="@(period == p.Item1 ? "on" : "")" onclick="location.href='@Url.Action("Analytics")?period=@p.Item1'">@p.Item2</button>
            }
        </div>
        <button class="btn pri" type="button" id="aiAnalyze" data-period="@period"><img src="~/img/brand/m-lemon.png" style="width:20px" alt="" />Анализ ИИ</button>
    </div>
</div>

<div id="aiOut" class="glass card rise mb-3" style="display:grid;grid-template-columns:auto 1fr;gap:20px;align-items:start" hidden>
    <img src="~/img/brand/m-lemon.png" style="height:110px;width:auto;object-fit:contain" alt="" />
    <div style="min-width:0">
        <div class="card-h" style="margin-bottom:10px">
            <span class="eyebrow" style="color:var(--ac)">Вывод ИИ — что убрать из закупок</span>
            <span class="sp"></span>
            <button class="btn sm ico ghost" type="button" id="aiClose" title="Закрыть">×</button>
        </div>
        <p id="aiText" class="sv-ai-text" style="white-space:pre-wrap;margin:0;font-size:14px;line-height:1.6">Анализирую статдамп…</p>
    </div>
</div>

<div class="grid" style="grid-template-columns:1.2fr 1fr">
    <section class="glass card rise">
        <div class="card-h">
            <span class="an-arrow an-down" title="теряет деньги">↓</span>
            <div><div class="ttl">Топ-5 неликвидов</div><div class="dim" style="font-size:12px">просрочка / поступления</div></div>
        </div>
        <div class="rows">
            @foreach (var (s, i) in deadStock.Select((x, i) => (x, i)))
            {
                var pct = (decimal)s.WasteShare;
                <div class="row" style="grid-template-columns:34px 1fr 140px 56px">
                    <span class="disp" style="font-weight:700;color:@(i < 2 ? "var(--rd)" : "var(--tx3)")">@($"{i + 1:00}")</span>
                    <div><b style="font-size:14px">@s.Name</b><div class="bar" style="margin-top:7px;color:var(--rd)"><i style="width:@($"{pct * 100:0}")%;background:linear-gradient(90deg,var(--ac),var(--rd))"></i></div></div>
                    <span class="mono dim" style="font-size:11.5px;text-align:right">@($"{s.Expired:0.##}") / @($"{s.Received:0.##}") @s.Unit · ~@($"{s.WasteRub:N0}") ₽</span>
                    <span class="badge rd" style="justify-self:end">@($"{pct * 100:0}")%</span>
                </div>
            }
        </div>
        @if (!deadStock.Any())
        {
            <div class="sv-empty"><img src="~/img/brand/m-avo.png" alt="" style="height:110px" /><p>Просроченных списаний за период не было.</p></div>
        }
    </section>
    <section class="glass card rise">
        <div class="card-h">
            <span class="an-arrow an-up" title="продаётся">↑</span>
            <div><div class="ttl">Топ-5 ходовых</div><div class="dim" style="font-size:12px">отгрузка на кухню</div></div>
        </div>
        <div class="rows">
            @foreach (var (s, i) in movers.Select((x, i) => (x, i)))
            {
                <div class="row" style="grid-template-columns:1fr auto">
                    <div><b style="font-size:14px">@s.Name</b><div class="dim" style="font-size:11.5px">@s.Category</div></div>
                    <b class="mono c-gr" style="text-align:right">@($"{s.Throughput:0.##}") @s.Unit</b>
                </div>
            }
        </div>
        @if (!movers.Any())
        {
            <div class="sv-empty"><img src="~/img/brand/m-onigiri.png" alt="" style="height:110px" /><p>Нет данных об отгрузке.</p></div>
        }
    </section>
</div>

@section Scripts {
<script>
document.getElementById('aiAnalyze').addEventListener('click', async function(){
    var box=document.getElementById('aiOut'), tx=document.getElementById('aiText');
    box.hidden=false; tx.textContent='Анализирую статдамп…'; this.disabled=true;
    try{
        var r=await fetch('/Inventory/AnalyticsAi?period='+this.dataset.period,{method:'POST'});
        var d=await r.json();
        tx.textContent=d.answer||'ИИ недоступен — смотри таблицу неликвидов ниже.';
    }catch(e){tx.textContent='ИИ недоступен — смотри таблицу неликвидов ниже.';}
    this.disabled=false;
});
document.getElementById('aiClose').addEventListener('click',function(){document.getElementById('aiOut').hidden=true;});
document.querySelectorAll('.fade-up').forEach(function(el,i){setTimeout(function(){el.classList.add('in');},50+i*60);});
</script>
@await Html.PartialAsync("_InventoryRealtime")
}
