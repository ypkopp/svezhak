@using Microsoft.AspNetCore.Identity
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string action) => currentController == "Inventory" && currentAction == action ? " active" : "";
    var isAuthed = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — СВЕЖАК</title>
    <script>
      // Тема применяется синхронно ДО загрузки CSS — без вспышки (FOUC).
      (function(){try{var t=localStorage.getItem('sv-theme')||'A';var r=document.documentElement;r.classList.add(t==='B'?'theme-b':'theme-a');r.dataset.theme=t;}catch(e){}})();
    </script>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700;800&family=Manrope:wght@400;500;600;700;800&family=Unbounded:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="~/img/brand/svezhak-logo-dark-2x.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/svezhak.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartInventory.styles.css" asp-append-version="true" />
</head>
<body class="sv-app-body">
<div class="sv-background" aria-hidden="true"></div>
@if (isAuthed)
{
    <div class="sv-app-shell">
        <aside class="sv-handoff-sidebar">
            <a class="sv-handoff-logo" asp-controller="Inventory" asp-action="Index">
                <img src="~/img/brand/svezhak-logo-dark-animated.svg" asp-append-version="true" alt="СВЕЖАК" />
            </a>
            <nav class="sv-handoff-nav sv-nav-offset" aria-label="Основная навигация">
                <a asp-controller="Inventory" asp-action="Index" class="sv-handoff-nav-item@(Active("Index"))">
                    <span class="sv-nav-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="12" y1="15" x2="16.5" y2="9.5"/><rect x="10.6" y="13.6" width="2.8" height="2.8" fill="currentColor" stroke="none"/><line x1="4" y1="20" x2="20" y2="20"/><line x1="5" y1="15" x2="7" y2="15"/><line x1="17" y1="15" x2="19" y2="15"/></svg></span><span data-i18n="nav.dash">Дашборд</span><b class="sv-nav-badge sv-badge-danger">@((int?)ViewBag.KpiExpiring ?? 0)</b>
                </a>
                <a asp-controller="Inventory" asp-action="Stock" class="sv-handoff-nav-item@(Active("Stock"))"><span class="sv-nav-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21V3M21 21V3M3 11h18M3 20h18"/><rect x="6" y="5.5" width="4.5" height="4"/><rect x="12.5" y="14" width="5" height="4.5"/><rect x="6" y="15.5" width="3.5" height="3"/></svg></span><span data-i18n="nav.stock">Склад</span></a>
                <a asp-controller="Inventory" asp-action="Deliveries" class="sv-handoff-nav-item@(Active("Deliveries"))"><span class="sv-nav-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 11v10h16V11"/><path d="M2.5 11h6l1.5 2.5h4l1.5-2.5h6"/><path d="M12 2v7M8.5 6l3.5 3.5L15.5 6"/></svg></span><span data-i18n="nav.deliv">Поставки</span></a>
                <a asp-controller="Inventory" asp-action="Order" class="sv-handoff-nav-item@(Active("Order"))"><span class="sv-nav-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h12v18l-2-1.5-2 1.5-2-1.5-2 1.5-2-1.5-2 1.5z"/><path d="M9 8h6M9 11.5h6M9 15h3"/></svg></span><span data-i18n="nav.order">Заказ</span></a>
                <a asp-controller="Inventory" asp-action="StopList" class="sv-handoff-nav-item@(Active("StopList"))"><span class="sv-nav-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 3h8l5 5v8l-5 5H8l-5-5V8z"/><path d="M8 12h8"/></svg></span><span data-i18n="nav.stop">Стоп-лист</span><b class="sv-nav-badge sv-badge-success">0</b></a>
                <a asp-controller="Advisor" asp-action="Index" class="sv-handoff-nav-item@(currentController == "Advisor" ? " active" : "")"><span class="sv-nav-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><path d="M12 12l6.5-6.5"/></svg></span><span data-i18n="nav.advisor">Советник</span></a>
                @if (isAdmin)
                {
                    <a asp-controller="Admin" asp-action="Employees" class="sv-handoff-nav-item@(currentController == "Admin" ? " active" : "")"><span class="sv-nav-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20v-4M4 8V4M20 4v4M20 16v4M4 12h16"/><circle cx="12" cy="8" r="3"/><circle cx="12" cy="16" r="3"/></svg></span><span data-i18n="nav.admin">Админ</span></a>
                }
            </nav>
            @await Component.InvokeAsync("ShiftWidget")
            <div class="sv-sidebar-foot">
                @if (isAdmin)
                {
                    <form asp-controller="Inventory" asp-action="ResetDemo" method="post" onsubmit="return confirm('Сбросить демо-данные? Все заказы и списания будут удалены.');">
                        @Html.AntiForgeryToken()
                        <button class="sv-sidebar-action is-danger" type="submit">↺ <span>Сбросить демо</span></button>
                    </form>
                }
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button class="sv-sidebar-action" type="submit">↪ <span>Выйти</span></button>
                </form>
            </div>
        </aside>
        <div class="sv-main-shell">
            <header class="sv-handoff-topbar">
                <label class="sv-global-search sv-cmd-trigger" id="cmdTrigger" role="button" tabindex="0">
                    <span class="sv-cmd-ic">⌘</span>
                    <span class="sv-cmd-hint">Быстрое действие…</span>
                </label>
                <div class="sv-topbar-tools">
                    <button class="sv-icon-button" type="button" id="qrBtn" aria-label="QR для кухни" title="QR для кухни — стоп-лист">⌗</button>
                    <button class="sv-lang-switch" type="button" id="langSwitch" aria-label="Сменить язык"><b id="langCur">RU</b></button>
                    <button class="sv-theme-switch" type="button" data-theme-toggle aria-label="Сменить тему">
                        <span class="sv-theme-knob"><img src="~/img/brand/favicon-32.png" alt="" /></span>
                        <span class="sv-theme-label"><strong data-i18n="theme.switch">СМЕНИТЬ ТЕМУ</strong><small data-theme-sub>Скан · оранж</small></span>
                    </button>
                    <span class="sv-led-clock" data-led-clock>00:00</span>
                    <div class="sv-bell-wrap">
                        <button class="sv-icon-button" type="button" id="bellBtn" aria-label="Уведомления">♢<i id="bellDot" hidden></i></button>
                        <div class="sv-bell-drop" id="bellDrop" hidden>
                            <div class="sv-bell-head"><b>Уведомления</b><button id="bellRead" type="button">прочитано</button></div>
                            <div id="bellList"><div class="sv-bell-empty">Загрузка…</div></div>
                        </div>
                    </div>
                    <a class="sv-profile" asp-controller="Account" asp-action="Profile" title="Профиль"><b>@((User.Identity?.Name ?? "?").FirstOrDefault())</b><span><strong>@User.Identity?.Name</strong><small>профиль →</small></span></a>
                </div>
            </header>
            <main class="sv-handoff-main" role="main">@RenderBody()</main>
            <footer class="sv-handoff-footer">© 2026 — СВЕЖАК · мониторинг остатков и сроков годности</footer>
        </div>
    </div>

    @* ===== ⌘K — палитра быстрых действий ===== *@
    <div class="sv-cmd-palette" id="cmdPalette" hidden>
        <div class="sv-cmd-box" role="dialog" aria-modal="true" aria-label="Быстрые действия">
            <div class="sv-cmd-input-wrap"><input id="cmdInput" type="text" placeholder="Действие…" autocomplete="off" /><kbd>Esc</kbd></div>
            <div class="sv-cmd-list" id="cmdList"></div>
        </div>
    </div>

    @* ===== QR для кухни — модалка ===== *@
    <div class="sv-modal-wrap" id="qrModal" hidden>
        <div class="sv-modal" role="dialog" aria-modal="true" aria-label="QR для кухни">
            <div class="sv-modal-head"><b>QR для кухни</b><button type="button" id="qrClose" aria-label="Закрыть">×</button></div>
            <div class="sv-modal-body">
                <div id="qrBox" class="sv-qr-box"></div>
                <p class="sv-surface-caption">Повар сканирует с телефона и видит стоп-лист — что нельзя готовить.</p>
                <a id="qrLink" href="@Url.Action("StopList","Inventory")" class="sv-ai-note d-block mb-3" target="_blank"></a>
                <button class="btn-sv-primary w-100" type="button" id="qrPrint">Распечатать</button>
            </div>
        </div>
    </div>
}
else
{
    <main role="main">@RenderBody()</main>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="~/js/i18n.js" asp-append-version="true"></script>
<script src="~/js/svezhak-shell.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
