@using Microsoft.AspNetCore.Identity
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string action) =>
        currentController == "Inventory" && currentAction == action ? " active" : "";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - СВЕЖАК</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="~/img/brand/logo-3b-sm.png"/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/svezhak.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/SmartInventory.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="sv-navbar">
        <div class="container-fluid px-4 d-flex align-items-center flex-wrap">
            <a class="sv-brand me-2 d-flex align-items-center" asp-controller="Inventory" asp-action="Index">
                <img src="~/img/brand/logo-3b-sm.png" asp-append-version="true" alt="СВЕЖАК" style="height:36px" />
                <span class="ms-2" style="letter-spacing:.06em">СВЕЖАК</span>
            </a>
            @await Html.PartialAsync("_Pulse")
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-expanded="false" aria-label="Toggle navigation" style="border-color: var(--sv-border)">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between flex-grow-1">
                <ul class="navbar-nav">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item"><a class="nav-link sv-nav-link@(Active("Index"))" asp-controller="Inventory" asp-action="Index">Дашборд</a></li>
                        <li class="nav-item"><a class="nav-link sv-nav-link@(Active("Stock"))" asp-controller="Inventory" asp-action="Stock">Склад</a></li>
                        <li class="nav-item"><a class="nav-link sv-nav-link@(Active("Deliveries"))" asp-controller="Inventory" asp-action="Deliveries">Поставки</a></li>
                        <li class="nav-item"><a class="nav-link sv-nav-link@(Active("Order"))" asp-controller="Inventory" asp-action="Order">Заказ</a></li>
                        <li class="nav-item"><a class="nav-link sv-nav-link@(Active("StopList"))" asp-controller="Inventory" asp-action="StopList">Стоп-лист</a></li>
                    }
                </ul>
                <ul class="navbar-nav ms-auto align-items-sm-center">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item me-2">
                            <form asp-controller="Inventory" asp-action="ResetDemo" method="post"
                                  onsubmit="return confirm('Сбросить демо-данные? Все заказы и списания будут удалены.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-sv-danger btn-sm">⟲ Сбросить демо</button>
                            </form>
                        </li>
                        <li class="nav-item">
                            <span class="nav-link sv-muted">@User.Identity.Name</span>
                        </li>
                        <li class="nav-item">
                            <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="nav-link btn btn-link sv-nav-link">Выйти</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link sv-nav-link" asp-controller="Account" asp-action="Login">Войти</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container py-4">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer sv-muted" style="border-color: var(--sv-border) !important; background: var(--sv-bg)">
    <div class="container py-3">
        &copy; 2026 — СВЕЖАК · мониторинг остатков и сроков годности
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
