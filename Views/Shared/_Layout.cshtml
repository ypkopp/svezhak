@using Microsoft.AspNetCore.Identity
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string action) => currentController == "Inventory" && currentAction == action ? " active" : "";
    var isAuthed = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
    var isOwner = User.IsInRole("OrganizationOwner");
    var isManager = User.IsInRole("RestaurantManager");
    // Повару — вместо блока «сколько человек на смене» просто кнопка «смотреть расписание»
    var isCook = User.IsInRole("Staff") || User.IsInRole("HeadChef");
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — СВЕЖАК</title>
    <meta name="description" content="СВЕЖАК — мониторинг склада ресторана: партии со сроками, FEFO-списание, авто стоп-лист, hot offers, ИИ-советник. Склад без просрочки." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="СВЕЖАК" />
    <meta property="og:title" content="СВЕЖАК — склад без просрочки" />
    <meta property="og:description" content="Шеф и ИИ следят за складом ресторана вместе: партии со сроками, FEFO, авто стоп-лист, hot offers, ИИ-советник." />
    <meta property="og:image" content="https://app.umirhack.tech/img/brand/kv-collab.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="СВЕЖАК — склад без просрочки" />
    <meta name="twitter:description" content="Партии со сроками, FEFO-списание, авто стоп-лист, hot offers, ИИ-советник." />
    <meta name="twitter:image" content="https://app.umirhack.tech/img/brand/kv-collab.png" />
    <script>
      // Тема применяется синхронно ДО загрузки CSS — без вспышки (FOUC).
      // data-theme: 5 тем v6 (night|paper|mono|matcha|lilac), ключ sv6-theme.
      // Совместимость: старый sv-theme A/B маппится на night/matcha.
      (function(){try{var r=document.documentElement;
        var t=localStorage.getItem('sv6-theme');
        if(!t){var old=localStorage.getItem('sv-theme');t=(old==='B')?'matcha':'night';}
        r.dataset.theme=t;}catch(e){}})();
    </script>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700;800&family=Manrope:wght@400;500;600;700;800&family=Unbounded:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="~/img/brand/svezhak-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/svezhak.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartInventory.styles.css" asp-append-version="true" />
</head>
<body class="sv-app-body">
<div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
<div class="sv-background" aria-hidden="true"></div>
@if (isAuthed)
{
    <div class="sv-app-shell">
        <aside class="sv-handoff-sidebar">
            <a class="sv-handoff-logo" asp-controller="Inventory" asp-action="Index">
                <img src="~/img/brand/svezhak-logo-dark-animated.svg" asp-append-version="true" alt="СВЕЖАК" class="sv-logo-img sv-logo-dark" style="height:38px" />
                <img src="~/img/brand/svezhak-logo-light.svg" asp-append-version="true" alt="СВЕЖАК" class="sv-logo-img sv-logo-light" style="height:38px" />
            </a>
            <nav class="sv-handoff-nav sv-nav-offset" aria-label="Основная навигация">
                <a asp-controller="Inventory" asp-action="Index" class="sv-handoff-nav-item@(Active("Index"))">
                    <span class="sv-nav-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="12" y1="15" x2="16.5" y2="9.5"/><rect x="10.6" y="13.6" width="2.8" height="2.8" fill="currentColor" stroke="none"/><line x1="4" y1="20" x2="20" y2="20"/><line x1="5" y1="15" x2="7" y2="15"/><line x1="17" y1="15" x2="19" y2="15"/></svg></span><span data-i18n="nav.dash">Дашборд</span><b class="sv-nav-badge sv-badge-danger">@((int?)ViewBag.KpiExpiring ?? 0)</b>
                </a>
                <a asp-controller="Inventory" asp-action="Stock" class="sv-handoff-nav-item@(Active("Stock"))"><span class="sv-nav-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21V3M21 21V3M3 11h18M3 20h18"/><rect x="6" y="5.5" width="4.5" height="4"/><rect x="12.5" y="14" width="5" height="4.5"/><rect x="6" y="15.5" width="3.5" height="3"/></svg></span><span data-i18n="nav.stock">Склад</span></a>
                <a asp-controller="Inventory" asp-action="Deliveries" class="sv-handoff-nav-item@(Active("Deliveries"))"><span class="sv-nav-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 11v10h16V11"/><path d="M2.5 11h6l1.5 2.5h4l1.5-2.5h6"/><path d="M12 2v7M8.5 6l3.5 3.5L15.5 6"/></svg></span><span data-i18n="nav.deliv">Поставки</span></a>
                <a asp-controller="Inventory" asp-action="Order" class="sv-handoff-nav-item@(Active("Order"))"><span class="sv-nav-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h12v18l-2-1.5-2 1.5-2-1.5-2 1.5-2-1.5-2 1.5z"/><path d="M9 8h6M9 11.5h6M9 15h3"/></svg></span><span data-i18n="nav.order">Заказ</span></a>
                <a asp-controller="Inventory" asp-action="StopList" class="sv-handoff-nav-item@(Active("StopList"))"><span class="sv-nav-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 3h8l5 5v8l-5 5H8l-5-5V8z"/><path d="M8 12h8"/></svg></span><span data-i18n="nav.stop">Стоп-лист</span><b class="sv-nav-badge sv-badge-success">0</b></a>
                <a asp-controller="Advisor" asp-action="Index" class="sv-handoff-nav-item@(currentController == "Advisor" ? " active" : "")"><span class="sv-nav-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><path d="M12 12l6.5-6.5"/></svg></span><span data-i18n="nav.advisor">Советник</span></a>
                <a asp-controller="Inventory" asp-action="Analytics" class="sv-handoff-nav-item@(Active("Analytics"))"><span class="sv-nav-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 20V10M9 20V4M15 20v-8M21 20V7"/></svg></span><span>Аналитика</span></a>
                @if (!isCook)
                {
                    <a asp-controller="Docs" asp-action="Index" class="sv-handoff-nav-item@(currentController == "Docs" ? " active" : "")"><span class="sv-nav-icon"><img src="~/img/brand/st-check.png" width="18" height="18" style="display:block" alt="" /></span><span>Как работает</span></a>
                }
                @if (isAdmin)
                {
                    <a asp-controller="Admin" asp-action="Employees" class="sv-handoff-nav-item@(currentController == "Admin" ? " active" : "")"><span class="sv-nav-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20v-4M4 8V4M20 4v4M20 16v4M4 12h16"/><circle cx="12" cy="8" r="3"/><circle cx="12" cy="16" r="3"/></svg></span><span data-i18n="nav.admin">Админ</span></a>
                }
                @if (isOwner)
                {
                    <a asp-controller="Org" asp-action="Index" class="sv-handoff-nav-item@(currentController == "Org" ? " active" : "")"><span class="sv-nav-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="5" cy="18" r="2"/><circle cx="19" cy="18" r="2"/><path d="M7 7.5l3 3M17 7.5l-3 3M7 16.5l3-3M17 16.5l-3-3"/></svg></span><span>Сеть</span></a>
                }
                @if (isManager && !isAdmin)
                {
                    <a asp-controller="Admin" asp-action="Employees" class="sv-handoff-nav-item@(currentController == "Admin" ? " active" : "")"><span class="sv-nav-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><circle cx="16" cy="9" r="2.4"/><path d="M3 20c0-3 3-5 6-5s6 2 6 5M15 15.5c2.4.3 4 2 4 4.5"/></svg></span><span>Команда</span></a>
                }
            </nav>
            @if (!isCook)
            {
                @await Component.InvokeAsync("ShiftWidget")
            }
            <div class="sv-sidebar-foot">
                @if (isCook)
                {
                    <a class="sv-sidebar-action" asp-controller="Schedule" asp-action="Index"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" style="vertical-align:-3px;margin-right:2px"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4"/></svg> <span>Расписание</span></a>
                    <a class="sv-sidebar-action" asp-controller="Docs" asp-action="Index">ⓘ <span>Как работает</span></a>
                }
                @if (isAdmin)
                {
                    <form asp-controller="Inventory" asp-action="ResetDemo" method="post" onsubmit="return confirm('Сбросить демо-данные? Все заказы и списания будут удалены.');">
                        @Html.AntiForgeryToken()
                        <button class="sv-sidebar-action is-danger" type="submit">↺ <span>Сбросить демо</span></button>
                    </form>
                }
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button class="sv-sidebar-action" type="submit">↪ <span>Выйти</span></button>
                </form>
            </div>
        </aside>
        <div class="sv-main-shell">
            <header class="sv-handoff-topbar">
                <label class="sv-global-search sv-cmd-trigger" id="cmdTrigger" role="button" tabindex="0">
                    <span class="sv-cmd-ic">⌘</span>
                    <span class="sv-cmd-hint">Быстрое действие…</span>
                </label>
                <div class="sv-topbar-tools">
                    <button class="sv-icon-button" type="button" id="qrBtn" aria-label="QR для кухни" title="QR для кухни — стоп-лист">⌗</button>
                    @* скрыто до полной локализации *@
                    <button class="sv-lang-switch" type="button" id="langSwitch" aria-label="Сменить язык" style="display:none"><b id="langCur">RU</b></button>
                    <div class="seg" id="themeSwatches" title="Тема"></div>
                    <span class="sv-led-clock" data-led-clock>00:00</span>
                    <button class="sv-icon-button" type="button" id="chatBtn" aria-label="ИИ-поддержка" title="ИИ-поддержка — спросить Юзу">✦</button>
                    <div class="sv-bell-wrap">
                        <button class="sv-icon-button" type="button" id="settingsBtn" aria-label="Настройки">⚙</button>
                        <div class="sv-bell-drop sv-settings-drop" id="settingsDrop" hidden>
                            <div class="sv-bell-head"><b>Настройки</b><button id="settingsReset" type="button">сброс</button></div>
                            <div class="sv-set-list">
                                <label class="sv-set-row"><input type="checkbox" data-set="hideDash" /><span>Скрыть «Дашборд» из меню</span></label>
                                <label class="sv-set-row"><input type="checkbox" data-set="hideTheme" /><span>Скрыть переключатель тем</span></label>
                                <label class="sv-set-row"><input type="checkbox" data-set="hideQr" /><span>Скрыть QR для кухни</span></label>
                                <label class="sv-set-row"><input type="checkbox" data-set="hideStar" /><span>Скрыть звёздочку стопа в заказе</span></label>
                                <label class="sv-set-row"><input type="checkbox" data-set="hideClock" /><span>Скрыть часы</span></label>
                                <div class="sv-set-row" style="flex-direction:column;align-items:stretch;gap:8px">
                                    <span class="dim" style="font-size:10px">Тема</span>
                                    <div class="seg" id="themeSwatchesIn"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <a class="sv-profile" asp-controller="Account" asp-action="Profile" title="Профиль"><b>@((User.Identity?.Name ?? "?").FirstOrDefault())</b><span><strong>@User.Identity?.Name</strong><small>профиль →</small></span></a>
                </div>
            </header>
            <main class="sv-handoff-main" role="main">@RenderBody()</main>
            <footer class="sv-handoff-footer">© 2026 — СВЕЖАК · мониторинг остатков и сроков годности</footer>
        </div>
    </div>

    @* ===== ⌘K — палитра быстрых действий ===== *@
    <div class="sv-cmd-palette" id="cmdPalette" hidden>
        <div class="sv-cmd-box" role="dialog" aria-modal="true" aria-label="Быстрые действия">
            <div class="sv-cmd-input-wrap"><input id="cmdInput" type="text" placeholder="Действие…" autocomplete="off" /><kbd>Esc</kbd></div>
            <div class="sv-cmd-list" id="cmdList"></div>
        </div>
    </div>

    @* ===== QR для кухни — модалка ===== *@
    <div class="sv-modal-wrap" id="qrModal" hidden>
        <div class="sv-modal" role="dialog" aria-modal="true" aria-label="QR для кухни">
            <div class="sv-modal-head"><b>QR для кухни</b><button type="button" id="qrClose" aria-label="Закрыть">×</button></div>
            <div class="sv-modal-body">
                <div id="qrBox" class="sv-qr-box"></div>
                <p class="sv-surface-caption">Повар сканирует с телефона и видит стоп-лист — что нельзя готовить.</p>
                <a id="qrLink" href="@Url.Action("StopList","Inventory")" class="sv-ai-note d-block mb-3" target="_blank"></a>
                <button class="btn-sv-primary w-100" type="button" id="qrPrint">Распечатать</button>
            </div>
        </div>
    </div>

    @* ===== ИИ-поддержка — выезжающая панель ===== *@
    <div class="sv-chat-panel" id="chatPanel" hidden>
        <div class="sv-chat-head">
            <div><div class="sv-kicker">ИИ-поддержка</div><b>Спросить Юзу</b></div>
            <button type="button" id="chatClose" aria-label="Закрыть">×</button>
        </div>
        <div class="sv-chat-msgs" id="chatMsgs">
            <div class="sv-chat-msg sv-chat-ai"><b>Юзу:</b> спроси про остатки, сроки, стоп-лист или потери — отвечу по текущему снапшоту склада. Если нужен человек — жми «Тикет админу».</div>
        </div>
        <div class="sv-chat-form" style="flex-direction:column;align-items:stretch;gap:8px">
            <div style="display:flex;gap:8px">
                <input id="chatInput" type="text" placeholder="что сгорит первым?" autocomplete="off" maxlength="400" style="flex:1" />
                <button type="button" id="chatSend" aria-label="Отправить">→</button>
            </div>
            <div class="sv-ticket-bar">
                <div class="dim" style="font-size:10.5px;line-height:1.4">Нужен человек? Напиши вопрос выше — он уйдёт админу как тикет.</div>
                <button type="button" class="btn sm" id="ticketBtn" style="width:100%;justify-content:center">🎫 Отправить тикет админу</button>
                <span class="dim" id="ticketStatus" style="font-size:10.5px;text-align:center"></span>
            </div>
        </div>
    </div>

    @* ===== Онбординг — первый вход менеджера/админа ===== *@
    <div class="sv-modal-wrap" id="onboard" hidden>
        <div class="sv-modal" style="width:min(480px,92vw)" role="dialog" aria-modal="true" aria-label="Обучение">
            <div class="sv-modal-head"><b id="obTitle">Добро пожаловать</b><button type="button" id="obSkip" aria-label="Пропустить">×</button></div>
            <div class="sv-modal-body" style="text-align:left">
                <div style="border-radius:14px;overflow:hidden;background:#0b0d11;height:150px;display:grid;place-items:center;margin-bottom:14px">
                    <img id="obImg" src="~/img/brand/chef-3-cut.png" style="max-height:130px" alt="" />
                </div>
                <div class="sv-kicker" id="obStep">шаг 1 / 5</div>
                <h3 id="obName" style="font:700 18px var(--disp);margin:6px 0 8px"></h3>
                <p id="obTx" style="color:var(--mut);font-size:13px;margin:0"></p>
            </div>
            <div class="modal-footer" style="border-top:1px solid #ffffff10;padding:14px 18px;display:flex;gap:10px;justify-content:space-between;align-items:center">
                <button type="button" class="btn-sv-ghost btn-sm" id="obSkip2">Пропустить</button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn-sv-ghost" id="obPrev" style="min-height:36px">←</button>
                    <button type="button" class="btn-sv-primary" id="obNext" style="min-height:36px">Далее →</button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <main role="main">@RenderBody()</main>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="~/js/i18n.js" asp-append-version="true"></script>
<script src="~/js/svezhak-shell.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
