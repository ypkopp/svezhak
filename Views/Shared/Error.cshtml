@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<div class="sv-login-wrap">
    <div class="sv-card sv-login-card">
        <div style="font-size:3rem; font-weight:800; color:var(--sv-red)">500</div>
        <div class="sv-page-sub mt-2">Что-то пошло не так при обработке запроса.</div>
        @if (Model?.ShowRequestId == true)
        {
            <p class="sv-muted" style="font-size:.8rem">Request ID: <code>@Model.RequestId</code></p>
        }
        <a class="btn-sv-primary d-inline-block mt-2" asp-controller="Inventory" asp-action="Index">На дашборд</a>
    </div>
</div>
