{
  "Database": {
    // "SqlServer" (локально, по умолчанию) | "Postgres" (Render).
    // Для Postgres строка берётся из env DATABASE_URL или ConnectionStrings:Postgres.
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=SmartInventoryDb;User Id=sa;Password=YOUR_PASSWORD_HERE;TrustServerCertificate=True;",
    "Postgres": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
