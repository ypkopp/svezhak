<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
      <UserSecretsId>7725dcb2-ebdf-4250-a44a-41d353dfbf44</UserSecretsId>
      <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="AutoMapper" Version="16.2.0" />
      <PackageReference Include="ClosedXML" Version="0.105.0" />
      <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    </ItemGroup>

    <ItemGroup>
      <None Update="docker-compose.yml">
        <DependentUpon>Dockerfile</DependentUpon>
      </None>
    </ItemGroup>

    <!-- Веб-проект собирает **/*.cs рекурсивно — исключаем каталог тестового
         проекта, иначе он ловит чужие файлы (xunit/Sqlite) и не собирается -->
    <ItemGroup>
      <Compile Remove="Svezhak.Tests/**" />
      <Content Remove="Svezhak.Tests/**" />
      <EmbeddedResource Remove="Svezhak.Tests/**" />
      <None Remove="Svezhak.Tests/**" />
      <Compile Remove="tools/**" />
      <Content Remove="tools/**" />
      <EmbeddedResource Remove="tools/**" />
      <None Remove="tools/**" />
    </ItemGroup>

</Project>
